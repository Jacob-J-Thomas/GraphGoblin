{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "@graphgoblin/api#test": {
      "dependsOn": ["@graphgoblin/api#build"]
    },
    "@graphgoblin/api#test:coverage": {
      "dependsOn": ["@graphgoblin/api#build"],
      "outputs": ["coverage/**"]
    },
    "@graphgoblin/tooling#test:coverage": {
      "outputs": []
    }
  }
}
