{
  "name": "@graphgoblin/plugin-claude",
  "version": "1.0.0",
  "description": "Claude Code plugin for GraphGoblin loop design, run, and inspection.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "plugin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node dist/cli.js",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "assemble": "node dist/cli.js"
  },
  "dependencies": {
    "@graphgoblin/tooling": "workspace:*"
  },
  "devDependencies": {
    "@graphgoblin/contracts": "workspace:*",
    "@graphgoblin/mcp": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
