{
  "name": "@graphgoblin/mcp",
  "version": "1.0.0",
  "description": "GraphGoblin MCP server: loop and run tools for agents, a thin client of the gateway API.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "graphgoblin-mcp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@graphgoblin/api-client": "workspace:*",
    "@graphgoblin/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@graphgoblin/api": "workspace:*",
    "@graphgoblin/tooling": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
