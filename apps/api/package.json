{
  "name": "@graphgoblin/api",
  "version": "0.1.0",
  "description": "GraphGoblin gateway: REST, SSE, OpenAPI, and the composition root for the engine and adapters.",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/test-app.ts",
      "types": "./dist/testing/test-app.d.ts",
      "import": "./dist/testing/test-app.js"
    }
  },
  "bin": {
    "graphgoblin-api": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "preflight": "node dist/main.js --preflight",
    "openapi": "node dist/emit-openapi.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@graphgoblin/adapter-codex": "workspace:*",
    "@graphgoblin/adapter-jev": "workspace:*",
    "@graphgoblin/contracts": "workspace:*",
    "@graphgoblin/domain": "workspace:*",
    "@graphgoblin/engine": "workspace:*",
    "@graphgoblin/infrastructure": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@graphgoblin/tooling": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
