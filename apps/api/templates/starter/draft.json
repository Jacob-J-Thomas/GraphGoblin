{
  "format": "graphgoblin-loop",
  "formatVersion": 3,
  "exportedAt": "2026-10-09T00:00:00.000Z",
  "loop": {
    "schemaVersion": 3,
    "name": "Starter assistant",
    "description": "Summarize supplied input and suggest a next step. Edit the workflow instructions, model defaults, or nodes at any time.",
    "settings": {
      "workingDirectory": {
        "kind": "temp"
      },
      "maxIterations": 10
    },
    "nodes": [
      {
        "id": "start",
        "kind": "trigger",
        "label": "Run input and context",
        "ui": {
          "x": 0,
          "y": 0
        },
        "config": {
          "subtype": "manual",
          "exposeTo": ["ui", "api", "mcp"]
        }
      },
      {
        "id": "instructions",
        "kind": "mutate",
        "label": "Workflow instructions",
        "ui": {
          "x": 270,
          "y": 0
        },
        "config": {
          "operations": [
            {
              "op": "set",
              "path": "/vars/instruction",
              "value": {
                "kind": "literal",
                "value": "Summarize the input and suggest a next step."
              }
            }
          ]
        }
      },
      {
        "id": "assistant",
        "kind": "inference",
        "label": "Assistant",
        "ui": {
          "x": 540,
          "y": 0
        },
        "config": {
          "harness": "codex",
          "session": {
            "policy": "fresh"
          },
          "prompt": {
            "template": "Instructions:\n{{ vars.instruction }}\n\nRun input and any supplied repository/task context:\n{{ invocation.trigger.payload | json }}\n\nUse only the supplied context and accessible working directory. Missing repository URLs, issue/PR numbers, credentials, or ownership are unknown; do not invent them. This is a manual editable workflow. Do not commit, push, merge, create or close issues/PRs, change labels, or contact external services.\n"
          },
          "harnessOptions": {
            "sandbox": "read-only",
            "approval": "never",
            "networkAccess": false,
            "webSearch": false
          },
          "timeoutSeconds": 300
        }
      },
      {
        "id": "done",
        "kind": "exit",
        "label": "Suggested next step",
        "ui": {
          "x": 810,
          "y": 0
        },
        "config": {
          "criteria": [],
          "default": "success",
          "return": {
            "mapping": "outputs.assistant.value",
            "channels": [
              {
                "kind": "caller"
              }
            ]
          }
        }
      }
    ],
    "edges": [
      {
        "id": "start-out-instructions",
        "from": {
          "node": "start",
          "port": "out"
        },
        "to": {
          "node": "instructions",
          "port": "in"
        }
      },
      {
        "id": "instructions-out-assistant",
        "from": {
          "node": "instructions",
          "port": "out"
        },
        "to": {
          "node": "assistant",
          "port": "in"
        }
      },
      {
        "id": "assistant-out-done",
        "from": {
          "node": "assistant",
          "port": "out"
        },
        "to": {
          "node": "done",
          "port": "in"
        }
      }
    ]
  }
}
