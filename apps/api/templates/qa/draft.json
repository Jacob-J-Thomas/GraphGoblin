{
  "format": "graphgoblin-loop",
  "formatVersion": 3,
  "exportedAt": "2026-10-09T00:00:00.000Z",
  "loop": {
    "schemaVersion": 3,
    "name": "QA evidence starting point",
    "description": "Define acceptance criteria, assess supplied test evidence, and challenge the assessment with one bounded rerun. This worksheet supplies neither authenticated post-merge proof nor enforced isolation.",
    "settings": {
      "workingDirectory": {
        "kind": "temp"
      },
      "maxIterations": 2
    },
    "nodes": [
      {
        "id": "start",
        "kind": "trigger",
        "label": "Run input and context",
        "ui": {
          "x": 0,
          "y": 0
        },
        "config": {
          "subtype": "manual",
          "exposeTo": ["ui", "api", "mcp"]
        }
      },
      {
        "id": "instructions",
        "kind": "mutate",
        "label": "Workflow instructions",
        "ui": {
          "x": 270,
          "y": 0
        },
        "config": {
          "operations": [
            {
              "op": "set",
              "path": "/vars/instruction",
              "value": {
                "kind": "literal",
                "value": "Assess the supplied change and test evidence against explicit acceptance criteria. Report observed results, gaps, and risks honestly."
              }
            }
          ]
        }
      },
      {
        "id": "criteria",
        "kind": "inference",
        "label": "Define acceptance criteria",
        "ui": {
          "x": 540,
          "y": 0
        },
        "config": {
          "harness": "codex",
          "session": {
            "policy": "fresh"
          },
          "prompt": {
            "template": "Instructions:\n{{ vars.instruction }}\n\nRun input and any supplied repository/task context:\n{{ invocation.trigger.payload | json }}\n\nUse only the supplied context and accessible working directory. Missing repository URLs, issue/PR numbers, credentials, or ownership are unknown; do not invent them. This is a manual editable workflow. Do not commit, push, merge, create or close issues/PRs, change labels, or contact external services.\n\nWrite concrete acceptance criteria and a feasible test/evidence plan for the supplied task or change. Distinguish required evidence from assumptions. This is an evidence worksheet, not an authenticated post-merge QA pipeline.\n"
          },
          "harnessOptions": {
            "sandbox": "read-only",
            "approval": "never",
            "networkAccess": false,
            "webSearch": false
          },
          "timeoutSeconds": 300
        }
      },
      {
        "id": "qa",
        "kind": "inference",
        "label": "Assess test evidence",
        "ui": {
          "x": 810,
          "y": 0
        },
        "config": {
          "harness": "codex",
          "session": {
            "policy": "fresh"
          },
          "prompt": {
            "template": "Instructions:\n{{ vars.instruction }}\n\nRun input and any supplied repository/task context:\n{{ invocation.trigger.payload | json }}\n\nUse only the supplied context and accessible working directory. Missing repository URLs, issue/PR numbers, credentials, or ownership are unknown; do not invent them. This is a manual editable workflow. Do not commit, push, merge, create or close issues/PRs, change labels, or contact external services.\n\nAcceptance criteria:\n{{ outputs.criteria.value | json }}\n{% if outputs.adversary %}Previous challenge:\n{{ outputs.adversary.value | json }}\n{% endif %}\nAssess supplied evidence and accessible files. You may perform read-only checks in the configured working directory. Report only observed tests and results. Missing evidence means inconclusive, failed behavior means fail, and pass requires sufficient observed evidence for every criterion. Do not claim enforced isolation, authenticated GitHub proof, or that this worksheet satisfies an automated post-merge gate. Return the required JSON status, summary, and evidence array.\n"
          },
          "harnessOptions": {
            "sandbox": "read-only",
            "approval": "never",
            "networkAccess": false,
            "webSearch": false
          },
          "timeoutSeconds": 300,
          "output": {
            "toMessages": "final",
            "schema": {
              "jsonSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "summary", "evidence"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["pass", "fail", "inconclusive"]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 32
                  }
                }
              },
              "native": true,
              "repair": {
                "enabled": true,
                "maxAttempts": 1,
                "onFailure": "fail-run"
              }
            }
          }
        }
      },
      {
        "id": "adversary",
        "kind": "inference",
        "label": "Challenge the assessment",
        "ui": {
          "x": 1080,
          "y": 0
        },
        "config": {
          "harness": "codex",
          "session": {
            "policy": "fresh"
          },
          "prompt": {
            "template": "Instructions:\n{{ vars.instruction }}\n\nRun input and any supplied repository/task context:\n{{ invocation.trigger.payload | json }}\n\nUse only the supplied context and accessible working directory. Missing repository URLs, issue/PR numbers, credentials, or ownership are unknown; do not invent them. This is a manual editable workflow. Do not commit, push, merge, create or close issues/PRs, change labels, or contact external services.\n\nAcceptance criteria:\n{{ outputs.criteria.value | json }}\nQA assessment:\n{{ outputs.qa.value | json }}\n\nChallenge unsupported conclusions, missing evidence, and invalid test reasoning. Return sound when this assessment is justified by the evidence, unsound when a bounded reassessment can repair it, or inconclusive when essential evidence is missing. Your read-only sandbox is not an enforced evidence-only isolation boundary. This opinion cannot reopen issues, relabel work, approve a merge, or create authenticated proof. Return the required JSON assessment and summary.\n"
          },
          "harnessOptions": {
            "sandbox": "read-only",
            "approval": "never",
            "networkAccess": false,
            "webSearch": false
          },
          "timeoutSeconds": 300,
          "output": {
            "toMessages": "final",
            "schema": {
              "jsonSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["assessment", "summary"],
                "properties": {
                  "assessment": {
                    "type": "string",
                    "enum": ["sound", "unsound", "inconclusive"]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "native": true,
              "repair": {
                "enabled": true,
                "maxAttempts": 1,
                "onFailure": "fail-run"
              }
            }
          }
        }
      },
      {
        "id": "assessment",
        "kind": "decision",
        "label": "Evidence assessment outcome",
        "ui": {
          "x": 1350,
          "y": 0
        },
        "config": {
          "answer": {
            "type": "choice",
            "options": [
              {
                "id": "passed",
                "label": "passed",
                "criteria": "passed"
              },
              {
                "id": "retry",
                "label": "retry",
                "criteria": "retry"
              },
              {
                "id": "blocked",
                "label": "blocked",
                "criteria": "blocked"
              }
            ]
          },
          "evaluation": {
            "kind": "expression",
            "jsonata": "outputs.adversary.value.assessment = 'sound' and outputs.qa.value.status = 'pass' ? 'passed' : (outputs.adversary.value.assessment = 'unsound' ? 'retry' : 'blocked')"
          }
        }
      },
      {
        "id": "done",
        "kind": "exit",
        "label": "Evidence assessment ready",
        "ui": {
          "x": 1620,
          "y": -160
        },
        "config": {
          "criteria": [],
          "default": "success",
          "return": {
            "mapping": "{\"qa\":outputs.qa.value,\"challenge\":outputs.adversary.value}",
            "channels": [
              {
                "kind": "caller"
              }
            ]
          }
        }
      },
      {
        "id": "blocked",
        "kind": "exit",
        "label": "Evidence missing or failed",
        "ui": {
          "x": 1620,
          "y": 160
        },
        "config": {
          "criteria": [
            {
              "when": "predicate",
              "answer": {
                "type": "noul"
              },
              "evaluation": {
                "kind": "expression",
                "jsonata": "true"
              },
              "match": {
                "type": "noul",
                "value": true
              },
              "outcome": "failure"
            }
          ],
          "default": "success",
          "return": {
            "mapping": "{\"qa\":outputs.qa.value,\"challenge\":outputs.adversary.value}",
            "channels": [
              {
                "kind": "caller"
              }
            ]
          }
        }
      },
      {
        "id": "retry",
        "kind": "exit",
        "label": "Reassess once within the limit",
        "ui": {
          "x": 810,
          "y": 300
        },
        "config": {
          "criteria": [],
          "default": "loop-back",
          "return": {
            "mapping": "{\"qa\":outputs.qa.value,\"challenge\":outputs.adversary.value}",
            "channels": [
              {
                "kind": "caller"
              }
            ]
          },
          "loopBack": {
            "targetNodeId": "qa"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "start-out-instructions",
        "from": {
          "node": "start",
          "port": "out"
        },
        "to": {
          "node": "instructions",
          "port": "in"
        }
      },
      {
        "id": "instructions-out-criteria",
        "from": {
          "node": "instructions",
          "port": "out"
        },
        "to": {
          "node": "criteria",
          "port": "in"
        }
      },
      {
        "id": "criteria-out-qa",
        "from": {
          "node": "criteria",
          "port": "out"
        },
        "to": {
          "node": "qa",
          "port": "in"
        }
      },
      {
        "id": "qa-out-adversary",
        "from": {
          "node": "qa",
          "port": "out"
        },
        "to": {
          "node": "adversary",
          "port": "in"
        }
      },
      {
        "id": "adversary-out-assessment",
        "from": {
          "node": "adversary",
          "port": "out"
        },
        "to": {
          "node": "assessment",
          "port": "in"
        }
      },
      {
        "id": "assessment-passed-done",
        "from": {
          "node": "assessment",
          "port": "passed"
        },
        "to": {
          "node": "done",
          "port": "in"
        }
      },
      {
        "id": "assessment-retry-retry",
        "from": {
          "node": "assessment",
          "port": "retry"
        },
        "to": {
          "node": "retry",
          "port": "in"
        }
      },
      {
        "id": "assessment-blocked-blocked",
        "from": {
          "node": "assessment",
          "port": "blocked"
        },
        "to": {
          "node": "blocked",
          "port": "in"
        }
      },
      {
        "id": "retry-loop-back",
        "from": {
          "node": "retry",
          "port": "loopBack"
        },
        "to": {
          "node": "qa",
          "port": "in"
        }
      }
    ]
  }
}
