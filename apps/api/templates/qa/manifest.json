{
  "id": "qa",
  "version": "1.0.0",
  "kind": "qa",
  "title": "Post-merge QA",
  "description": "Define acceptance criteria, assess evidence, and challenge the result with an independent review.",
  "tags": ["qa", "evidence", "adversarial"],
  "roles": [
    {
      "id": "qa",
      "label": "QA",
      "access": "write"
    },
    {
      "id": "adversary",
      "label": "Evidence-only adversary",
      "access": "read-only"
    }
  ],
  "prerequisites": [
    {
      "id": "qa",
      "label": "QA model and harness",
      "kind": "role",
      "blocking": "authoring",
      "role": "qa"
    },
    {
      "id": "adversary",
      "label": "Evidence-only adversary model and harness",
      "kind": "role",
      "blocking": "authoring",
      "role": "adversary"
    },
    {
      "id": "repository",
      "label": "Canonical repository and matching origin",
      "kind": "repository",
      "blocking": "authoring"
    },
    {
      "id": "github",
      "label": "Authenticated configured repository",
      "kind": "github",
      "blocking": "authoring"
    },
    {
      "id": "support-key",
      "label": "Revocable runs:read support key",
      "kind": "secret",
      "blocking": "authoring",
      "secretKey": "supportReadKey"
    },
    {
      "id": "support",
      "label": "Verified packaged QA support entry",
      "kind": "support",
      "blocking": "authoring"
    },
    {
      "id": "isolation",
      "label": "Enforced evidence-only isolation is unavailable",
      "kind": "isolation",
      "blocking": "runtime",
      "role": "adversary"
    }
  ],
  "requiredSecrets": [
    {
      "key": "supportReadKey",
      "scopes": ["runs:read"]
    }
  ],
  "parentKey": "parent",
  "loops": [
    {
      "key": "parent",
      "file": "parent.json",
      "dependsOn": ["adversary"],
      "roleNodes": [
        {
          "role": "qa",
          "nodeId": "criteria"
        },
        {
          "role": "qa",
          "nodeId": "execute"
        }
      ],
      "settingsNodes": ["settings"],
      "subloops": [
        {
          "nodeId": "adversary",
          "loopKey": "adversary"
        }
      ]
    },
    {
      "key": "adversary",
      "file": "adversary.json",
      "dependsOn": [],
      "roleNodes": [
        {
          "role": "adversary",
          "nodeId": "adversary"
        }
      ],
      "settingsNodes": [],
      "subloops": []
    }
  ],
  "supportEntry": "dist/templates/github/qa-entry.js",
  "draftFile": "draft.json"
}
