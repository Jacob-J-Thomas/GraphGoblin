{
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "instructions"],
      "properties": {
        "mode": {
          "const": "direct"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "tasks"],
      "properties": {
        "mode": {
          "const": "split"
        },
        "tasks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "instructions"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  ]
}
