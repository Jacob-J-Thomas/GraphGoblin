{
  "format": "graphgoblin-loop",
  "formatVersion": 3,
  "exportedAt": "2026-10-09T00:00:00.000Z",
  "loop": {
    "schemaVersion": 3,
    "name": "Implementation starting point",
    "description": "Plan a task, develop a proposed or local change, and verify its evidence with a finite repair loop. Configure a working directory in the editor when needed.",
    "settings": {
      "workingDirectory": {
        "kind": "temp"
      },
      "maxIterations": 3
    },
    "nodes": [
      {
        "id": "start",
        "kind": "trigger",
        "label": "Run input and context",
        "ui": {
          "x": 0,
          "y": 0
        },
        "config": {
          "subtype": "manual",
          "exposeTo": ["ui", "api", "mcp"]
        }
      },
      {
        "id": "instructions",
        "kind": "mutate",
        "label": "Workflow instructions",
        "ui": {
          "x": 270,
          "y": 0
        },
        "config": {
          "operations": [
            {
              "op": "set",
              "path": "/vars/instruction",
              "value": {
                "kind": "literal",
                "value": "Implement the supplied task as one bounded change. Plan first, make the change or propose a patch from supplied source, and verify what can be checked."
              }
            }
          ]
        }
      },
      {
        "id": "planner",
        "kind": "inference",
        "label": "Plan the change",
        "ui": {
          "x": 540,
          "y": 0
        },
        "config": {
          "harness": "codex",
          "session": {
            "policy": "fresh"
          },
          "prompt": {
            "template": "Instructions:\n{{ vars.instruction }}\n\nRun input and any supplied repository/task context:\n{{ invocation.trigger.payload | json }}\n\nUse only the supplied context and accessible working directory. Missing repository URLs, issue/PR numbers, credentials, or ownership are unknown; do not invent them. This is a manual editable workflow. Do not commit, push, merge, create or close issues/PRs, change labels, or contact external services.\n\nWrite a focused implementation plan with scope, steps, and concrete verification. If required task/source context is missing, identify it clearly. Read only; do not edit files.\n"
          },
          "harnessOptions": {
            "sandbox": "read-only",
            "approval": "never",
            "networkAccess": false,
            "webSearch": false
          },
          "timeoutSeconds": 300
        }
      },
      {
        "id": "implementer",
        "kind": "inference",
        "label": "Implement or propose the change",
        "ui": {
          "x": 810,
          "y": 0
        },
        "config": {
          "harness": "codex",
          "session": {
            "policy": "fresh"
          },
          "prompt": {
            "template": "Instructions:\n{{ vars.instruction }}\n\nRun input and any supplied repository/task context:\n{{ invocation.trigger.payload | json }}\n\nUse only the supplied context and accessible working directory. Missing repository URLs, issue/PR numbers, credentials, or ownership are unknown; do not invent them. This is a manual editable workflow. Do not commit, push, merge, create or close issues/PRs, change labels, or contact external services.\n\nPlan:\n{{ outputs.planner.value | json }}\n{% if outputs.verify %}Previous verification:\n{{ outputs.verify.value | json }}\n{% endif %}\nImplement the plan in the configured working directory when source is available. Otherwise provide a concrete proposed patch or change steps and clearly state that no repository files were changed. Record only commands actually run and results actually observed; do not claim unperformed tests passed.\n"
          },
          "harnessOptions": {
            "sandbox": "workspace-write",
            "approval": "never",
            "networkAccess": false,
            "webSearch": false
          },
          "timeoutSeconds": 900
        }
      },
      {
        "id": "verify",
        "kind": "inference",
        "label": "Verify the change and evidence",
        "ui": {
          "x": 1080,
          "y": 0
        },
        "config": {
          "harness": "codex",
          "session": {
            "policy": "fresh"
          },
          "prompt": {
            "template": "Instructions:\n{{ vars.instruction }}\n\nRun input and any supplied repository/task context:\n{{ invocation.trigger.payload | json }}\n\nUse only the supplied context and accessible working directory. Missing repository URLs, issue/PR numbers, credentials, or ownership are unknown; do not invent them. This is a manual editable workflow. Do not commit, push, merge, create or close issues/PRs, change labels, or contact external services.\n\nPlan:\n{{ outputs.planner.value | json }}\nImplementation:\n{{ outputs.implementer.value | json }}\n\nInspect the resulting files or proposed patch and any supplied evidence. Return status passed only when the stated task is satisfied by evidence you can assess; changes-needed for a bounded repair, or blocked when verification needs missing information or capabilities. Distinguish verified checks from proposed checks. Return the required JSON status, summary, and checks array.\n"
          },
          "harnessOptions": {
            "sandbox": "read-only",
            "approval": "never",
            "networkAccess": false,
            "webSearch": false
          },
          "timeoutSeconds": 300,
          "output": {
            "toMessages": "final",
            "schema": {
              "jsonSchema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "summary", "checks"],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["passed", "changes-needed", "blocked"]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 32
                  }
                }
              },
              "native": true,
              "repair": {
                "enabled": true,
                "maxAttempts": 1,
                "onFailure": "fail-run"
              }
            }
          }
        }
      },
      {
        "id": "verification",
        "kind": "decision",
        "label": "Verification outcome",
        "ui": {
          "x": 1350,
          "y": 0
        },
        "config": {
          "answer": {
            "type": "choice",
            "options": [
              {
                "id": "passed",
                "label": "passed",
                "criteria": "passed"
              },
              {
                "id": "changes-needed",
                "label": "changes-needed",
                "criteria": "changes-needed"
              },
              {
                "id": "blocked",
                "label": "blocked",
                "criteria": "blocked"
              }
            ]
          },
          "evaluation": {
            "kind": "expression",
            "jsonata": "outputs.verify.value.status"
          }
        }
      },
      {
        "id": "done",
        "kind": "exit",
        "label": "Change evidence ready",
        "ui": {
          "x": 1620,
          "y": -160
        },
        "config": {
          "criteria": [],
          "default": "success",
          "return": {
            "mapping": "outputs.verify.value",
            "channels": [
              {
                "kind": "caller"
              }
            ]
          }
        }
      },
      {
        "id": "blocked",
        "kind": "exit",
        "label": "Verification blocked",
        "ui": {
          "x": 1620,
          "y": 160
        },
        "config": {
          "criteria": [
            {
              "when": "predicate",
              "answer": {
                "type": "noul"
              },
              "evaluation": {
                "kind": "expression",
                "jsonata": "true"
              },
              "match": {
                "type": "noul",
                "value": true
              },
              "outcome": "failure"
            }
          ],
          "default": "success",
          "return": {
            "mapping": "outputs.verify.value",
            "channels": [
              {
                "kind": "caller"
              }
            ]
          }
        }
      },
      {
        "id": "retry",
        "kind": "exit",
        "label": "Retry within the iteration limit",
        "ui": {
          "x": 1080,
          "y": 300
        },
        "config": {
          "criteria": [],
          "default": "loop-back",
          "return": {
            "mapping": "outputs.verify.value",
            "channels": [
              {
                "kind": "caller"
              }
            ]
          },
          "loopBack": {
            "targetNodeId": "implementer"
          }
        }
      }
    ],
    "edges": [
      {
        "id": "start-out-instructions",
        "from": {
          "node": "start",
          "port": "out"
        },
        "to": {
          "node": "instructions",
          "port": "in"
        }
      },
      {
        "id": "instructions-out-planner",
        "from": {
          "node": "instructions",
          "port": "out"
        },
        "to": {
          "node": "planner",
          "port": "in"
        }
      },
      {
        "id": "planner-out-implementer",
        "from": {
          "node": "planner",
          "port": "out"
        },
        "to": {
          "node": "implementer",
          "port": "in"
        }
      },
      {
        "id": "implementer-out-verify",
        "from": {
          "node": "implementer",
          "port": "out"
        },
        "to": {
          "node": "verify",
          "port": "in"
        }
      },
      {
        "id": "verify-out-verification",
        "from": {
          "node": "verify",
          "port": "out"
        },
        "to": {
          "node": "verification",
          "port": "in"
        }
      },
      {
        "id": "verification-passed-done",
        "from": {
          "node": "verification",
          "port": "passed"
        },
        "to": {
          "node": "done",
          "port": "in"
        }
      },
      {
        "id": "verification-blocked-blocked",
        "from": {
          "node": "verification",
          "port": "blocked"
        },
        "to": {
          "node": "blocked",
          "port": "in"
        }
      },
      {
        "id": "verification-changes-needed-retry",
        "from": {
          "node": "verification",
          "port": "changes-needed"
        },
        "to": {
          "node": "retry",
          "port": "in"
        }
      },
      {
        "id": "retry-loop-back",
        "from": {
          "node": "retry",
          "port": "loopBack"
        },
        "to": {
          "node": "implementer",
          "port": "in"
        }
      }
    ]
  }
}
