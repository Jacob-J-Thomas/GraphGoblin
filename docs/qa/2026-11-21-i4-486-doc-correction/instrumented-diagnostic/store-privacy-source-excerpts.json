            "text": "    async close() {"
          },
          {
            "line": 122,
            "text": "      // Teardown is a storage/component boundary, not an operator stop. C2 reopens this store."
          },
          {
            "line": 123,
            "text": "      // If a test did request managed shutdown, settle that sequence before closing resources."
          },
          {
            "line": 124,
            "text": "      if (['draining', 'awaiting-choice', 'forcing'].includes(container.shutdown.state().phase)) {"
