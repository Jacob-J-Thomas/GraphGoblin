                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "audio"
                            },
                            "audio": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                                },
                                "mimeType": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128
                                },
                                "bytes": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 10485760
                                },
                                "path": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 4096,
                                  "pattern": "^(?:\\/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
                                }
                              },
                              "required": [
                                "id",
                                "mimeType",
                                "bytes",
                                "path"
                              ],
                              "additionalProperties": false
                            },
                            "caption": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 16000,
                              "pattern": "^(.|[\\r\\n\\u2028\\u2029])*[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](.|[\\r\\n\\u2028\\u2029])*$"
