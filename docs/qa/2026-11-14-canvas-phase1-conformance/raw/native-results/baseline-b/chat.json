                "protocol",
                "reply"
              ],
              "additionalProperties": false
            }
          },
          "nodes": [
            {
              "id": "chat-input",
              "label": "Chat input",
              "ui": {
                "x": 0,
                "y": 0
              },
              "kind": "trigger",
              "config": {
                "type": "manual",
                "inputSchema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "properties": {
                    "protocol": {
                      "type": "string",
                      "const": "graphgoblin.chat.v1"
                    },
                    "conversationId": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "turn": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "history": {
                      "maxItems": 24,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "role": {
                            "type": "string",
                            "enum": [
                              "user",
                              "assistant"
                            ]
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32000,
                            "pattern": "^(.|[\\r\\n\\u2028\\u2029])*[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](.|[\\r\\n\\u2028\\u2029])*$"
                          }
                        },
                        "required": [
                          "role",
                          "text"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "input": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "text"
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 16000,
                              "pattern": "^(.|[\\r\\n\\u2028\\u2029])*[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](.|[\\r\\n\\u2028\\u2029])*$"
                            }
                          },
                          "required": [
                            "kind",
                            "text"
