                "reply": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32000,
                  "pattern": "^(.|[\\r\\n\\u2028\\u2029])*[^\\u0009-\\u000D\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](.|[\\r\\n\\u2028\\u2029])*$"
