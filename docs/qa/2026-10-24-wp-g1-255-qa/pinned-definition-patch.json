{
  "schemaVersion": 4,
  "name": "Pinned multi-patch evidence",
  "settings": {
    "workingDirectory": {
      "kind": "temp"
    },
    "defaults": {
      "byHarness": {}
    },
    "maxNodeVisits": 10,
    "runDeadlineSeconds": null,
    "subloopDepthLimit": 8
  },
  "variables": {},
  "nodes": [
    {
      "id": "start",
      "label": "Pinned initial trigger",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "trigger",
      "config": {
        "type": "manual",
        "exposeTo": [
          "ui",
          "api",
          "mcp"
        ]
      }
    },
    {
      "id": "patch",
      "label": "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "mutate",
      "config": {
        "operations": [
          {
            "op": "set",
            "path": "/vars/array",
            "value": {
              "kind": "literal",
              "value": []
            }
          },
          {
            "op": "set",
            "path": "/vars/nested",
            "value": {
              "kind": "literal",
              "value": {
                "items": []
              }
            }
          },
          {
            "op": "set",
            "path": "/vars/object",
            "value": {
              "kind": "literal",
              "value": {}
            }
          },
          {
            "op": "set",
            "path": "/vars/array/-",
            "value": {
              "kind": "literal",
              "value": {
                "marker": "FIRST-original",
                "n": 0.12345678901234566
              }
            }
          },
          {
            "op": "set",
            "path": "/vars/array/-",
            "value": {
              "kind": "literal",
              "value": null
            }
          },
          {
            "op": "set",
            "path": "/vars/array/-",
            "value": {
              "kind": "literal",
              "value": [
                "THIRD",
                false
              ]
            }
          },
          {
            "op": "set",
            "path": "/vars/nested/items/-",
            "value": {
              "kind": "literal",
              "value": {
                "nested": "NESTED-original"
              }
            }
          },
          {
            "op": "set",
            "path": "/vars/nested/items/-",
            "value": {
              "kind": "literal",
              "value": "NESTED-second"
            }
          },
          {
            "op": "set",
            "path": "/vars/object/added",
            "value": {
              "kind": "literal",
              "value": {
                "truth": true
              }
            }
          },
          {
            "op": "set",
            "path": "/vars/object/remove",
            "value": {
              "kind": "literal",
              "value": "REMOVE-me"
            }
          },
          {
            "op": "set",
            "path": "/vars/array/0/marker",
            "value": {
              "kind": "literal",
              "value": "FIRST-replaced-in-same-node"
            }
          },
          {
            "op": "delete",
            "path": "/vars/object/remove"
          },
          {
            "op": "append-message",
            "role": "note",
            "content": "APPENDED message alpha"
          },
          {
            "op": "append-message",
            "role": "note",
            "content": "APPENDED message beta"
          }
        ]
      }
    },
    {
      "id": "later",
      "label": "Pinned later change",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "mutate",
      "config": {
        "operations": [
          {
            "op": "set",
            "path": "/vars/array/0/marker",
            "value": {
              "kind": "literal",
              "value": "FIRST-later-node"
            }
          },
          {
            "op": "set",
            "path": "/vars/nested/items/0/nested",
            "value": {
              "kind": "literal",
              "value": "NESTED-later-node"
            }
          }
        ]
      }
    },
    {
      "id": "done",
      "label": "Pinned completion",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "exit",
      "config": {
        "outcome": "success",
        "returns": "none",
        "destinations": [
          {
            "kind": "caller"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "start-out",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "patch",
        "port": "in"
      }
    },
    {
      "id": "patch-out",
      "from": {
        "node": "patch",
        "port": "out"
      },
      "to": {
        "node": "later",
        "port": "in"
      }
    },
    {
      "id": "later-out",
      "from": {
        "node": "later",
        "port": "out"
      },
      "to": {
        "node": "done",
        "port": "in"
      }
    }
  ]
}