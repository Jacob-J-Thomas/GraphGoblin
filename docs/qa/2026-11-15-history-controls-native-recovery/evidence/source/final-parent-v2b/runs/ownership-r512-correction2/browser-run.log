    check(up.input.x === down.input.x && up.input.y === down.input.y && up.t - down.t >= minimumHold - 5,
      label + ' invalid pointer hold witness', 'fixture');
    const index = direction === 'undo' ? 0 : 1;
    const active = frames.filter((f) => f.t >= down.t && f.t <= up.t && f.directions[index]?.active);
    check(active.length > 0, label + ' no sampled active CSS treatment', 'unwitnessed');
    check(active.every((f) => f.directions[index].translate === 'none' && f.directions[index].transform === 'none'),
      label + ' computed active history movement');
    if (active[0].directions[index].disabled !== 'true') check(
      active.some((f) => f.directions[index].border !== down.directions[index].border) ||
        active.some((f) => f.directions[index].border !== frames.find((pre) => pre.t < down.t)?.directions[index]?.border),
      label + ' enabled press has no sampled border treatment');
    return frames;
  }
  async function samplerControl() {
    const original = await snapshot();
    await page.evaluate(() => new Promise((done) => {
      requestAnimationFrame(() => {
        const node = document.querySelector('[data-history="undo"]');
        node.style.position = 'relative';
        node.style.top = '1px';
        requestAnimationFrame(() => {
          node.style.removeProperty('position');
          node.style.removeProperty('top');
          done();
        });
      });
    }));
    const frames = await trace('sampler-control', false);
    check(frames.some((f) => f.boxes[0]?.[1] === original.boxes[0][1] + 1 && f.boxes[1]?.join() === original.boxes[1].join()),
      'Sampler missed one frame of known one-pixel motion', 'fixture');
    same((await snapshot()).boxes, original.boxes, 'Sampler control restored the original geometry');
  }
  async function publish(held = true) {
    publishGate = held ? gate() : undefined;
    const publishButton = page.getByRole('button', { name: 'Publish', exact: true });
    await mark('publish-held');
    if (coarse) await publishButton.tap({ timeout: 10000 });
    else await publishButton.click({ timeout: 10000 });
    if (held) {
      await until(() => publishGate.used, 'held POST publish');
      await page.getByRole('button', { name: 'Publishing…', exact: true }).waitFor({ timeout: 10000 });
      await wait(130);
      publishGate.release();
    }
    await page.getByText('published v1', { exact: true }).waitFor({ timeout: 12000 });
    await mark('published-current-only-visible');
    const settled = await get();
    out.checkpoints.push({ label: 'post-publish current-only readback', before: baseline, settled });
    check(settled.current && !Object.hasOwn(settled, 'draft') && !Object.hasOwn(settled.loop, 'draftVersionId') && settled.loop.currentVersionId === settled.current.id, 'Publish must leave current and no draft');
    same(settled.current.definition, def(baseline), 'Published definition exactly matches the fixture');
    same(settled.draftToken, baseline.draftToken, 'Publishing unchanged content keeps its content token');
    const frames = await trace('publish');
    check((!held || frames.some((f) => f.publish === 'Publishing…')) && frames.some((f) => f.badge === 'published v1'),
      'Sampler did not witness both publish states', 'fixture');
    baseline = settled;
  }
  async function openWorkCard(card) {
    if (config === 'r512-reflow200') {
      const before = await get();
      const beforeFrame = await snapshot();
      const count = writes().length;
      await mark('native-Fit-View-preparation');
      await page.getByRole('button', {name:/^fit view$/i}).click({timeout:10000});
      const target = await until(() => card.evaluate(el => {
        const r=el.getBoundingClientRect();
        const c=el.closest('.react-flow').getBoundingClientRect();
        const x=r.x+r.width/2,y=r.y+r.height/2;
        const hit=document.elementFromPoint(x,y);
        return x>=c.left && x<c.right && y>=c.top && y<c.bottom && el.contains(hit)
          ? {box:[r.x,r.y,r.width,r.height],canvas:[c.x,c.y,c.width,c.height],point:[x,y],actualTarget:hit.closest('.react-flow__node')?.getAttribute('data-id')} : null;
      }), 'work card real centre hit after native Fit View');
      const after=await get();
      same(def(after),def(before),'Native Fit View kept complete server graph');
      same(after.draftToken,before.draftToken,'Native Fit View kept content token');
      check(writes().length===count,'Native Fit View unexpectedly wrote graph');
      same((await snapshot()).boxes,beforeFrame.boxes,'Native Fit View kept history targets');
      notes.push({label:'native Fit View prepared actual work target',target,before,after});
      await trace('native-fit-view-preparation');
    }
    await card.click({timeout:10000});
  }

  async function dialog(prior) {
    const card = page.locator('.react-flow__node[data-id="work"]');
    const modal = page.locator('dialog:modal');
    await mark('dialog');
    await openWorkCard(card);
    await modal.waitFor({ timeout: 10000 });
    const before = await snapshot();
    const count = writes().length;
    for (let i = 0; i < 14; i++) {
      await page.keyboard.press('Tab');
      check(await modal.evaluate((dialog) => dialog.contains(document.activeElement)), 'Tab escaped modal');
    }
    await page.mouse.click(...before.coords[0]);
    check(writes().length === count, 'Inert modal canvas history click wrote a draft');
    await restored(knownAdd, 'Dialog background click inert');
    await get().then((server) => same(def(server), def(prior), 'Inert modal kept graph'));
    if (!await modal.isVisible()) await openWorkCard(card);
    const field = modal.getByRole('textbox', { name: 'Node id', exact: true });
    // The node-id input stages text until blur. Exercise real native text undo before blur.
    const textBefore = await field.inputValue();
    const textWrites = writes().length;
    await field.click({ timeout: 10000 });
    await page.keyboard.press('End');
    await page.keyboard.type('x');
    same(await field.inputValue(), textBefore + 'x', 'Native text entry reached staged node-id');
    await page.keyboard.press('Control+z');
    same(await field.inputValue(), textBefore, 'Text field owns native Ctrl+Z');
    await restored(knownAdd, 'Text field owns Ctrl+Z');
    await wait(740);
    check(writes().length === textWrites, 'Text-local undo must not write graph history');
    same(def(await get()), def(prior), 'Text-local undo kept complete server graph');
    const heading = modal.getByRole('heading').first();
    await heading.focus();
    const undo = await apply('dialog-Ctrl+Z', () => page.keyboard.press('Control+z'), prior, def(baseline));
    check(await modal.isVisible(), 'Global history should not close the retained modal');
    await page.keyboard.press('Escape');
    await modal.waitFor({ state: 'hidden', timeout: 10000 });
    check(await card.evaluate((el) => el === document.activeElement || el.contains(document.activeElement)),
      'Modal Escape did not focus its surviving card');
    await trace('dialog', false);
    return undo;
  }
  async function normal() {
    const resumeD1 = group === 'h-d1';
    const first = await open(!resumeD1);
    await historyAttributes(true);
    if (!resumeD1) {
      check(first.some((f) => f.validation === 'Checking…') && first.some((f) => f.validation === 'Ready to publish'),
        'No first-paint checking/ready transition in trace', 'fixture');
      await focusOrder();
      await trace('focus-order');
      await mark('disabled-top-row');
      await hitHistory('undo', { top: true, hold: 250 });
      await wait(740);
      check(writes().length === 0 && (await snapshot()).focused === 'undo', 'Disabled control must keep focus without writer');
      await restored(def(baseline), 'Disabled case');
      await verifyPress('disabled-top-row', 'undo');
    }
    // D1's first paint, focus, disabled press, held Publish and 1px control already passed.
    // Ordinary publication establishes the exact current-only baseline needed for the remaining actions.
    await publish(!resumeD1);

    let current = await apply('add Script', addScript, baseline);
    recordAdd(baseline, current);
    await historyAttributes(false);
    check((await snapshot()).validation?.includes('error'), 'Valid-to-errors transition missing after adding disconnected Script');
    await trace('validation-errors');

    current = await apply('first top-row Undo', () => hitHistory('undo', { top: true, hold: 250, enabled: true }), current, def(baseline));
    await restored(def(baseline), 'Top-row Undo');
    await readyLabel.waitFor({ timeout: 10000 });
    await verifyPress('top-undo', 'undo');
    await historyAttributes(false);

    current = await apply('first top-row Redo', () => hitHistory('redo', { top: true, hold: 250, enabled: true }), current, knownAdd);
    await restored(knownAdd, 'Top-row Redo');
    await verifyPress('top-redo', 'redo');

    for (const [key, expected] of [
      ['Control+z', def(baseline)], ['Control+Shift+z', knownAdd], ['Control+z', def(baseline)], ['Control+y', knownAdd],
    ]) current = await apply(key, () => page.keyboard.press(key), current, expected);
    await trace('shortcut-sequence');

    await button('undo').focus();
    current = await apply('held Space Undo', async () => {
      await page.keyboard.down('Space');
      try { await wait(250); } finally { await page.keyboard.up('Space'); }
    }, current, def(baseline));
    const keyboard = await trace('keyboard-space');
    const spaceDown = keyboard.find((f) => f.type === 'keydown' && f.input.key === ' ' && f.input.trusted);
    const spaceUp = keyboard.find((f) => f.type === 'keyup' && f.input.key === ' ' && f.input.trusted && spaceDown && f.t >= spaceDown.t);
    check(spaceDown && spaceUp && spaceUp.t - spaceDown.t >= 245, 'No trusted 250ms Space hold');
    check(keyboard.some((f) => f.directions[0]?.active) && keyboard.every((f) =>
      !f.directions[0]?.active || (f.directions[0].translate === 'none' && f.directions[0].transform === 'none')), 'No stationary Space-held CSS witness');
    await button('redo').focus();
    current = await apply('Enter Redo', () => page.keyboard.press('Enter'), current, knownAdd);
    await trace('keyboard-enter');

    if (coarse) {
      current = await apply('coarse tap Undo', () => hitHistory('undo', { tap: true }), current, def(baseline));
      const tapped = await trace('coarse-tap');
      check(tapped.some((f) => f.type === 'pointerdown' && f.input.pointer === 'touch' && f.input.trusted), 'No native touch tap event');
      current = await apply('coarse tap Redo', () => hitHistory('redo', { tap: true }), current, knownAdd);
      const redoTap = await trace('coarse-redo');
      check(redoTap.some((f) => f.type === 'pointerdown' && f.input.pointer === 'touch' && f.input.trusted), 'No native Redo touch tap event');
      out.limits.push('Edge coarse touch tap is measured. Physical touch hold remains unresolved');
    }

    const prior = current;
    putGate = gate();
    const count = writes().length;
    await mark('held-save');
    await addScript();
    await until(() => putGate.used && writes().length > count, 'held PUT request');
    check((await snapshot()).save === 'Saving…', 'Held PUT did not reach Saving…', 'fixture');
    const point = (await snapshot()).coords[0];
    await page.mouse.move(...point);
    await page.mouse.down();
    let changed;
    let undoCount;
    try {
      await wait(250);
      putGate.release();
      changed = await saved('held add Script', count, prior);
      undoCount = writes().length;
    } finally {
      await page.mouse.up();
    }
    current = await saved('held-transition Undo', undoCount, changed, knownAdd);
    const held = await verifyPress('held-put-transition', 'undo');
    const down = held.find((f) => f.type === 'mousedown' && f.input.target === 'undo');
    const up = held.find((f) => f.type === 'mouseup' && f.t >= down.t);
    check(held.some((f) => f.t > down.t && f.t < up.t && f.save === 'All changes saved'),
      'Saving to Saved did not occur during the real hold', 'unwitnessed');
    if (['h-d1','h-r512'].includes(group)) current = await dialog(current);
    current = await heldValidation(current);
    return current;
  }

  async function heldValidation(prior) {
    // Return to the valid published graph, then make one distinct valid edit through the UI.
    // A fresh label changes the validation key; undoing an old edit can hit a cached valid key.
    if (JSON.stringify(canonical(def(prior))) !== JSON.stringify(canonical(def(baseline)))) {
      prior = await apply('prepare valid validation fixture', () => hitHistory('undo', { enabled: true }), prior, def(baseline));
    }
    await readyLabel.waitFor({timeout:10000});
    await trace('validation-fixture-ready');
    const card = page.locator('.react-flow__node[data-id="work"]');
    await openWorkCard(card);
    const modal = page.locator('dialog:modal');
    await modal.waitFor({timeout:10000});
    const label = 'Validation hold ' + crypto.randomUUID().slice(0, 7);
    const expected = {...def(baseline), nodes:def(baseline).nodes.map(node => node.id === 'work' ? {...node,label} : node)};
    validationGate = gate();
    const count = writes().length;
    await modal.getByRole('textbox', {name:'Label',exact:true}).fill(label);
    await page.keyboard.press('Escape');
    await modal.waitFor({state:'hidden',timeout:10000});
    const changed = await saved('valid label before held validation', count, prior, expected);
    await until(() => validationGate.used, 'distinct valid revision held validation');
    check((await snapshot()).validation === 'Checking…', 'Held fresh valid validation must be Checking', 'fixture');
    // Exclude modal inertness from the fixed-hittarget interval; retain its raw frames separately.
    await trace('validation-edit-dialog', false);
    await mark('validation-held-enabled-undo');
    const position = await button('undo').evaluate(el => {
      const r = el.getBoundingClientRect(), x = r.x + r.width/2;
      const hit = y => el.contains(document.elementFromPoint(x,y));
      const y0 = Math.ceil(r.top);
      const y = [y0-1,y0,y0+1].find(row => hit(row) && !hit(row-1));
      return y === undefined ? null : {x,y};
    });
    check(position && (await snapshot()).directions[0].disabled !== 'true', 'Held validation needs enabled upper-row Undo', 'fixture');
    notes.push({label:'held validation locked upper row', position, expected, prior:changed});
    const undoCount = writes().length;
    await page.mouse.move(position.x,position.y);
    await page.mouse.down();
    try {
      await wait(250);
      validationGate.release();
      await readyLabel.waitFor({timeout:10000});
      await mark('ready-during-enabled-hold');
    } finally { await page.mouse.up(); }
    const undone = await saved('held-validation Undo', undoCount, changed, def(baseline));
    const frames = await verifyPress('held-validation-transition','undo');
    const down = frames.find(f => f.type === 'mousedown' && f.input.target === 'undo');
    const up = frames.find(f => f.type === 'mouseup' && f.t >= down.t);
    check(frames.some(f => f.t <= down.t && f.validation === 'Checking…') &&
      frames.some(f => f.t > down.t && f.t < up.t && f.validation === 'Ready to publish'),
      'Checking to Ready must visibly resolve during the enabled native hold', 'unwitnessed');
    await restored(def(baseline), 'Held validation restored complete graph');
    return undone;
  }

  async function remainingR512() {
    // The first R512 run passed all normal history phases through held PUT. Preserve those.
    await open(false);
    await historyAttributes(true);
    await publish(false);
    let current=await apply('one distinctive step for remaining modal',addScript,baseline);
    recordAdd(baseline,current);
    await trace('remaining-modal-fixture');
    current=await dialog(current);
    await heldValidation(current);
    out.limits.push('R512 correction2 runs only remaining modal and held-validation phases; first-run history/keyboard/held-PUT/wrap passes retained');
  }

  async function inPageBanner(prefix, where) {
    const found = await until(async () => {
      const f = await snapshot();
      return f.banners.find((banner) => banner.text.startsWith(prefix) && banner.where === where && banner.visible && !banner.hidden);
    }, where + ' ' + prefix);
    const suffix = prefix === 'You are offline' ? 'when you reconnect.' : 'when the API is reachable again.';
    same(found.text, prefix + 'The app keeps working with what it has; saving, running, and live updates resume ' + suffix,
      'Exact connection banner copy');
    check(await status().count() === 1, 'Exactly one connection status role');
    const locator = status();
    if (typeof locator.ariaSnapshot === 'function') notes.push({ state: where, aria: await locator.ariaSnapshot() });
    if (where === 'editor') {
      const f = await snapshot();
      check(found.bounds[1] >= f.toolbar[1] + f.toolbar[3] - 0.02, 'Editor banner starts below toolbar');
    }
    return found;
  }
  async function connectivity() {
    if (group === 'http500') {
      control = 'http500';
      const failedValidation = await open(false, 'Validation unavailable');
      check(requests.some((req) => req.path.endsWith('/validate') && req.status === 500), 'Missing actual validate HTTP 500');
      check(failedValidation.every((f) => f.banners.length === 0), 'Validation HTTP 500 showed a connection banner');
      control = 'pass';
    }
    await open();
    const fail = group;
    const prior = await apply('before fault palette edit', addScript, baseline);
    recordAdd(baseline, prior);
    await trace('before-fault');
    const fixed = (await snapshot()).coords[0];
    const count = writes().length;

    if (fail === 'offline') {
      await page.context().setOffline(true);
      await inPageBanner('You are offline', 'editor');
    } else if (fail === 'unreachable') control = 'abort-all';
    else if (fail === 'put-flash') control = 'abort-put';
    else control = 'http500';
    await mark('fault-' + fail);
    await hitHistory('undo', { point: {x: fixed[0], y: fixed[1]} });
    await restored(def(baseline), 'History when fault is active');

    if (fail === 'unreachable') {
      await inPageBanner('Cannot reach the GraphGoblin API', 'editor');
      check((await snapshot()).online, 'Transport test must keep navigator online');
    }
    if (fail === 'http500') await until(async () => (await snapshot()).save === 'Save failed', 'Save failed label');
    const device = await until(async () => {
      const value = await localDraft();
      return value?.synced === false && value.baseToken === prior.draftToken &&
        JSON.stringify(canonical(value.definition)) === JSON.stringify(canonical(def(baseline))) && value;
    }, 'exact device-only Undo');
    const pending = await get();
    same(def(pending), def(prior), 'Fault left canonical server definition exact');
    same(pending.draftToken, prior.draftToken, 'Fault kept canonical server token');
    if (fail !== 'offline') {
      await until(() => writes().slice(count).find((req) => fail === 'http500' ? req.status === 500 : req.error),
        'browser draft fault witness');
    }
    const frames = await trace('active-fault');
    if (fail === 'http500') check(frames.every((f) => f.banners.length === 0), 'HTTP 500 incorrectly classified as connectivity');
    if (fail === 'put-flash') {
      const flash = frames.filter((f) => f.banners.length);
      if (!flash.length) out.limits.push('PUT-only abort witnessed but no banner frame or mutation observed');
      check(flash.every((f) => f.banners.every((banner) => banner.where === 'editor')), 'PUT-only flash painted above toolbar');
    }
    out.checkpoints.push({ label: 'fault still active', pending, device, faultWrites: writes().slice(count) });
    const restoreCount = writes().length;
    control = 'pass';
    if (fail === 'offline') await page.context().setOffline(false);
    if (fail === 'offline' || fail === 'unreachable') {
      await saved('real reconnect acknowledgement', restoreCount, prior, def(baseline));
      await until(async () => (await snapshot()).banners.length === 0, 'banner recovery');
    } else {
      const addMutate = () => {
        const loc = page.getByRole('button', {name:'Add Mutate node', exact:true}).first();
        return coarse ? loc.tap({timeout:10000}) : loc.click({timeout:10000});
      };
      const recovered = await apply('ordinary later edit saves', addMutate, prior);
      const after = def(recovered);
      const oldIds = ids(def(baseline));
      const fresh = after.nodes.filter((node) => !oldIds.includes(node.id));
      check(fresh.length === 1 && fresh[0].kind === 'mutate', 'Later recovery should add one Mutate node');
      same({...after, nodes:after.nodes.filter((node) => node.id !== fresh[0].id)}, def(baseline), 'Later edit preserved device Undo');
    }
    await trace('recover');
  }

  async function nav(name) {
    const compact = page.getByRole('button', {name:'Menu',exact:true});
    if (await compact.isVisible()) await compact.click({timeout:10000});
    await page.getByRole('navigation', {name:'Main'}).getByRole('link', {name,exact:true}).click({timeout:10000});
  }
  async function ownership() {
    // Only the previously unreached native error subphase. Other ownership transitions passed.
    const name = 'QA missing escalation ' + crypto.randomUUID().slice(0,7);
    loopId = await create(name);
    await page.reload();
    out.settings = await page.evaluate(() => ({cssViewport:[innerWidth,innerHeight],dpr:devicePixelRatio,
      coarse:matchMedia('(pointer: coarse)').matches,theme:document.documentElement.dataset.theme,
      rootFont:getComputedStyle(document.documentElement).fontSize}));
    same([...out.settings.cssViewport,out.settings.dpr], config === 'd1-fine-light' ? [1440,900,1] : [512,384,2],
      'Ownership effective viewport/DPR');
    check(!out.settings.coarse && out.settings.theme === 'light' && out.settings.rootFont === '16px',
      'Ownership config mismatch','fixture');
    const entry = page.getByRole('link',{name:'Edit '+name,exact:true});
    await entry.waitFor({timeout:12000});
    await api('DELETE',path(loopId),204);
    await mark('load-error-online-retry');
    await entry.click({timeout:10000});
    await page.getByText('Could not load loop',{exact:true}).waitFor({timeout:10000});
    const failed = requests.filter(req => req.method === 'GET' && req.path === path(loopId) && req.status === 404);
    check(failed.length === 2, 'Expected first real GET404 and configured one online retry', 'fixture');
    check((await snapshot()).online, '404 retries must complete while online', 'fixture');
    await mark('native-error-established-online');
    await page.context().setOffline(true);
    const banner = await inPageBanner('You are offline','shell');
    check(await historySlot.count() === 0, 'Unavailable editor rendered claimed history');
    await page.getByText('Could not load loop',{exact:true}).waitFor({timeout:10000});
    out.checkpoints.push({label:'native error owns one shell status after both 404s', failed, banner});
    await trace('ownership-native-load-error',false);
    await page.context().setOffline(false);
    out.limits.push('Prior shell/loading/loaded/route/re-entry passes retained without rerun. Voice staging and unrelated notices remain source/component evidence only');
  }

  async function n360() {
    await open(true);
    await historyAttributes(true);
    await focusOrder();
    await publish();
    const measurements = await historySlot.evaluate((slot) => {
      const header = slot.closest('header');
      const interactive = [...header.querySelectorAll('a[href],button,[role="link"]')];
      return { viewport: innerWidth, pageWidth: document.documentElement.scrollWidth, headerWidth: header.clientWidth,
        headerScrollable: header.scrollWidth, targets: interactive.map((node) => {
          const rect = node.getBoundingClientRect();
          const hit = document.elementFromPoint(rect.x + rect.width / 2, rect.y + rect.height / 2);
          return { text: node.textContent.trim(), x: rect.left, right: rect.right, width: rect.width,
            centreHittable: node.contains(hit) };
        }) };
    });
    out.checkpoints.push({label:'360 px clipping guard',measurements});
    check(measurements.pageWidth <= measurements.viewport && measurements.headerScrollable <= measurements.headerWidth,
      '360 px editor horizontally overflows ' + JSON.stringify(measurements));
    check(measurements.targets.every((target) => target.x >= -0.02 && target.right <= measurements.viewport + 0.02 &&
      target.centreHittable), '360 px toolbar clipped a real action ' + JSON.stringify(measurements.targets));
    await trace('360px-guard');
  }

  try {
    check(/^http:\/\/127\.0\.0\.1:\d+$/.test(origin) && /^http:\/\/127\.0\.0\.1:\d+$/.test(sink) &&
      !/:474[78]$/.test(origin) && !/:474[78]$/.test(sink), 'Disposed gateway/sink only', 'fixture');
    const health = await page.request.get(origin + '/healthz');
    check(health.ok() && health.headers()['x-graphgoblin-pid'] === read('qa-pid'), 'Gateway identity mismatch', 'fixture');
    const asset = await page.request.get(origin + read('qa-bundle'));
    check(asset.ok(), 'Expected browser bundle unavailable', 'fixture');
    await setupRequests();
    await page.addInitScript(installProbe, theme);
    await page.evaluate(installProbe, theme);
    if (group === 'h-r512') await remainingR512();
    else if (group.startsWith('h-')) await normal();
    else if (group.startsWith('ownership-')) await ownership();
    else if (group === 'n360') await n360();
    else await connectivity();
    await page.screenshot({path:'final.png'});
  } catch (error) {
    out.failure = { kind: error.kind ?? 'unclassified', message: String(error.message), stack: String(error.stack) };
    try { await trace('first-failure', false); } catch { /* existing evidence files remain */ }
    try { await page.screenshot({path:'first-failure.png'}); } catch { /* screenshot best effort only */ }
  } finally {
    for (const pending of [loadGate, putGate, validationGate, publishGate]) pending?.release();
    await Promise.allSettled(responseReads);
    await sinkPost('actions.json',{out,notes,phases,requests});
  }
  return JSON.stringify({ suite: out.suite, group, config, failure: out.failure, pageErrors: out.pageErrors,
    summary: {geometry: out.geometry, checkpoints: out.checkpoints.map((point) => point.label), limits: out.limits } });
}
)(page);
