{
  "test": {
    "id": "a2-provider-template",
    "tier": "composed",
    "mode": "provider-template",
    "calls": 1,
    "ops": [
      {
        "op": "set",
        "path": "/vars/qaBefore",
        "value": {
          "kind": "literal",
          "value": true
        }
      },
      {
        "op": "set",
        "path": "/vars/qaRaw",
        "value": {
          "kind": "literal",
          "value": {
            "ok": "yes"
          }
        }
      },
      {
        "op": "coerce",
        "source": "/vars/qaRaw",
        "target": "/vars/qaClean",
        "jsonSchema": {
          "type": "object",
          "required": [
            "ok"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            }
          }
        },
        "repair": {
          "enabled": true,
          "maxAttempts": 1,
          "onFailure": "fail-run"
        }
      },
      {
        "op": "set",
        "path": "/vars/qaAfter",
        "value": {
          "kind": "literal",
          "value": true
        }
      }
    ],
    "expect": {
      "status": "failed",
      "code": "INTERNAL_ERROR",
      "resumable": true
    }
  },
  "definition": {
    "schemaVersion": 4,
    "name": "QA 381 a2-provider-template",
    "nodes": [
      {
        "id": "start",
        "kind": "trigger",
        "label": "Start",
        "config": {
          "type": "manual"
        }
      },
      {
        "id": "mut",
        "kind": "mutate",
        "label": "QA mutation",
        "config": {
          "operations": [
            {
              "op": "set",
              "path": "/vars/qaBefore",
              "value": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "set",
              "path": "/vars/qaRaw",
              "value": {
                "kind": "literal",
                "value": {
                  "ok": "yes"
                }
              }
            },
            {
              "op": "coerce",
              "source": "/vars/qaRaw",
              "target": "/vars/qaClean",
              "jsonSchema": {
                "type": "object",
                "required": [
                  "ok"
                ],
                "properties": {
                  "ok": {
                    "type": "boolean"
                  }
                }
              },
              "repair": {
                "enabled": true,
                "maxAttempts": 1,
                "onFailure": "fail-run"
              }
            },
            {
              "op": "set",
              "path": "/vars/qaAfter",
              "value": {
                "kind": "literal",
                "value": true
              }
            }
          ]
        }
      },
      {
        "id": "done",
        "kind": "exit",
        "label": "Done",
        "config": {
          "outcome": "success",
          "returns": "vars",
          "destinations": [
            {
              "kind": "caller"
            }
          ]
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "start",
          "port": "out"
        },
        "to": {
          "node": "mut"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "mut",
          "port": "out"
        },
        "to": {
          "node": "done"
        }
      }
    ]
  }
}
