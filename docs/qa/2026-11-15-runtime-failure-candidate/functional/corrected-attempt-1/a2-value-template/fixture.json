            }
          ]
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "start",
          "port": "out"
        },
        "to": {
          "node": "mut"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "mut",
          "port": "out"
