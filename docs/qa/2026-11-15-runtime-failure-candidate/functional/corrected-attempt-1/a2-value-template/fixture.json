{
  "test": {
    "id": "a2-value-template",
    "tier": "native",
    "ops": [
      {
        "op": "set",
        "path": "/vars/qaBefore",
        "value": {
          "kind": "literal",
          "value": true
        }
      },
      {
        "op": "set",
        "path": "/vars/qaAnswer",
        "value": {
          "kind": "template",
          "template": "{{ \"qa-381-template\" | append }}"
        }
      },
      {
        "op": "set",
        "path": "/vars/qaAfter",
        "value": {
          "kind": "literal",
          "value": true
        }
      }
    ],
    "expect": {
      "status": "failed",
      "index": 1,
      "op": "set",
      "kind": "template",
      "cause": "append expect 2 arguments"
    }
  },
  "definition": {
    "schemaVersion": 4,
    "name": "QA 381 a2-value-template",
    "nodes": [
      {
        "id": "start",
        "kind": "trigger",
        "label": "Start",
        "config": {
          "type": "manual"
        }
      },
      {
        "id": "mut",
        "kind": "mutate",
        "label": "QA mutation",
        "config": {
          "operations": [
            {
              "op": "set",
              "path": "/vars/qaBefore",
              "value": {
                "kind": "literal",
                "value": true
              }
            },
            {
              "op": "set",
              "path": "/vars/qaAnswer",
              "value": {
                "kind": "template",
