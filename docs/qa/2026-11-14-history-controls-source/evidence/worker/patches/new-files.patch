+    expect(slot).toHaveClass('shrink-0', 'h-9', 'pointer-coarse:h-11', 'items-center', 'gap-2');
+    expect(slot).not.toHaveClass('ml-auto', 'flex-wrap', 'justify-end', 'self-center');
+    const content = slot.nextElementSibling!;
