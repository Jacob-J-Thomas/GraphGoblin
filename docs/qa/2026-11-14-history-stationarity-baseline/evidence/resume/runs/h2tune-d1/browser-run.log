      for (const p of [[b.x + 0.5, b.y + 0.5], [b.x + b.w - 0.5, b.y + 0.5], [b.x + 0.5, b.y + b.h - 0.5], [b.x + b.w - 0.5, b.y + b.h - 0.5],
        [b.x + b.w / 2, b.y + 0.5], [b.x + b.w / 2, b.y + b.h - 0.5], [b.x + 0.5, b.y + b.h / 2], [b.x + b.w - 0.5, b.y + b.h / 2]]) pts.push([p[0], p[1], 'edge']);
