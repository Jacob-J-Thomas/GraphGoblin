  // ---------------------------------------------------------------- cases
  async function caseH12() {
    await loadPhase(); await restPhase();
    await phase('burst', () => burst(0, 12, GAP));
    await phase('settle', async () => { await sleep(4200); return { snap: await snap(), screenshot: await shot('after-burst') }; });
    await phase('keys', async () => {
      const seq = [['Control+z', 'undo'], ['Control+z', 'undo'], ['Control+Shift+z', 'redo'], ['Control+y', 'redo']];
      const recs = [];
      for (let k = 0; k < seq.length; k++) {
        const pre = await snap();
        await mark('key:' + seq[k][0]);
        await page.keyboard.press(seq[k][0]);
        await sleep(200);
        const post = await snap();
        recs.push({ key: seq[k][0], dir: seq[k][1], nodeDelta: post.nodes - pre.nodes, pre: { nodes: pre.nodes, uAD: pre.uAD, rAD: pre.rAD, focus: pre.focus }, post: { nodes: post.nodes, uAD: post.uAD, rAD: post.rAD, focus: post.focus, ub: post.ub, rb: post.rb } });
      }
      return recs;
    });
    await phase('settle2', async () => { const w = await waitFor((s) => s.save === 'All changes saved', 8000, 150); return { ok: w.ok, waitedMs: w.waitedMs, snap: w.last }; });
    await finalPhase();
  }

  async function caseH12Held() {
    await loadPhase(); await restPhase();
    ctl.policy = (tag) => (/^PUT .*\/draft$/.test(tag) || /^POST .*\/validate$/.test(tag)) ? { kind: 'hold', ms: 1000 } : /^POST .*\/publish$/.test(tag) ? { kind: 'hold', ms: 1500 } : { kind: 'pass' };
    await phase('publish', async () => {
      // Real click on Publish with POST /publish (and any save) held by this driver, so the
      // wider "Publishing…" label and the published badge appear while history stays idle.
      const pre = await snap();
      const c = await page.evaluate(() => {
        const b = [...document.querySelectorAll('button')].find((x) => (x.textContent || '').trim() === 'Publish');
        if (!b) return null;
        const r = b.getBoundingClientRect();
        return { x: r.x + r.width / 2, y: r.y + r.height / 2, box: [r.x, r.y, r.width, r.height], disabled: b.disabled };
      });
      if (!c) throw new Error('Publish button missing');
      await mark('publish:click', { c: [c.x, c.y] });
      await page.mouse.move(c.x, c.y, { steps: 3 }); await page.mouse.down(); await sleep(60); await page.mouse.up();
      const tClick = Date.now();
      const busy = await waitFor((s) => s.pub === 'Publishing…', 4000, 25);
      const busySnap = busy.last;
      const done = await waitFor((s) => /^published v\d+$/.test(s.badge || '') && s.pub === 'Publish', 20000, 50);
      return { pre: { ub: pre.ub, rb: pre.rb, badge: pre.badge, val: pre.val, pub: pre.pub }, publishButton: c, publishingSeen: busy.ok, publishingAfterClickMs: busy.waitedMs,
        busy: { ub: busySnap.ub, rb: busySnap.rb, pub: busySnap.pub, badge: busySnap.badge }, publishedSeen: done.ok, publishedAfterClickMs: Date.now() - tClick, done: done.last };
    });
    await phase('after-publish', async () => {
      await sleep(900);
      const base = await page.evaluate(() => window.__qa.setBase());
      return { snap: await snap(), base, screenshot: await shot('published') };
    });
    await phase('burst', () => burst(0, 12, GAP));
    await phase('settle', async () => { const w = await waitFor((s) => s.save === 'All changes saved', 12000, 100); await sleep(1500); return { ok: w.ok, waitedMs: w.waitedMs, snap: await snap(), screenshot: await shot('after-burst') }; });
    await phase('press-over-transition', async () => {
      ctl.policy = (tag) => (/^PUT .*\/draft$/.test(tag) || /^POST .*\/validate$/.test(tag)) ? { kind: 'hold', ms: 1500 } : { kind: 'pass' };
      // Make Undo enabled with a fresh step, then press Undo and keep holding while the save and
      // validation labels change underneath it.
      const add = await addNode(100, 'Script', 150); actions.push(add);
      const sv = await waitFor((s) => s.save === 'Saving…', 4000, 40);
      const c = await center('[data-history=undo]');
      await page.mouse.move(c.x, c.y, { steps: 3 });
      await mark('pot:down', { c: [c.x, c.y], saveAtDown: sv.last && sv.last.save });
      await page.mouse.down(); const tDown = Date.now();
      const flip = await waitFor((s) => s.save === 'All changes saved', 6000, 25);
      const flipAt = Date.now() - tDown;
      await sleep(300);
      const atUp = await snap();
      const cUp = await center('[data-history=undo]');
      await page.mouse.up(); const tUp = Date.now();
      await sleep(300);
      const post = await snap();
      return { addNodeDelta: add.post.nodes - add.pre.nodes, savingSeen: sv.ok, flipSeen: flip.ok, flipAfterDownMs: flipAt, downCenter: [c.x, c.y], downBox: c.box, upCenter: [cUp.x, cUp.y], upBox: cUp.box,
        boxMovedWhileHeld: jstr(c.box) !== jstr(cUp.box), preNodes: add.post.nodes, postNodes: post.nodes, undoEffect: post.nodes - add.post.nodes, heldMs: tUp - tDown, atUp, post };
    });
    ctl.policy = () => ({ kind: 'pass' });
    await phase('settle3', async () => { const w = await waitFor((s) => s.save === 'All changes saved', 12000, 150); return { ok: w.ok, waitedMs: w.waitedMs, snap: w.last }; });
    await finalPhase();
  }

  async function caseH3() {
    await loadPhase(); await restPhase();
    const presses = [];
    out.presses = presses;
    await phase('press-undo-disabled', async () => { const r = await press('[data-history=undo]', [30, 120, 150], {}); presses.push({ name: 'undo-aria-disabled', ...r }); return { nodeDelta: r.post.nodes - r.pre.nodes }; });
    await phase('add-one', async () => { const r = await addNode(0, 'Script', 300); actions.push(r); return { nodeDelta: r.post.nodes - r.pre.nodes }; });
    await phase('press-undo-enabled', async () => { const r = await press('[data-history=undo]', [30, 120, 150], {}); presses.push({ name: 'undo-enabled', ...r }); return { nodeDelta: r.post.nodes - r.pre.nodes }; });
    await phase('press-undo-disabled-again', async () => { const r = await press('[data-history=undo]', [30, 120, 150], {}); presses.push({ name: 'undo-aria-disabled-after-undo', ...r }); return { nodeDelta: r.post.nodes - r.pre.nodes }; });
    await phase('press-redo-enabled', async () => { const r = await press('[data-history=redo]', [30, 120, 150], {}); presses.push({ name: 'redo-enabled', ...r }); return { nodeDelta: r.post.nodes - r.pre.nodes }; });
    await phase('press-redo-disabled', async () => { const r = await press('[data-history=redo]', [30, 120, 150], {}); presses.push({ name: 'redo-aria-disabled', ...r }); return { nodeDelta: r.post.nodes - r.pre.nodes }; });
    await phase('press-undo-enabled-drag-off', async () => { const r = await press('[data-history=undo]', [30, 150], { moveOffBeforeUp: true }); presses.push({ name: 'undo-enabled-released-outside', ...r }); return { nodeDelta: r.post.nodes - r.pre.nodes }; });
    await phase('edge-click-loss', async () => {
      // Integer-aligned presses on an ENABLED Undo: top pixel row, bottom pixel row, centre. While
      // held, the pressed translate moves the box 1 px down; is the click still delivered to it?
      const results = [];
      const sel = '[data-history=undo]';
      for (const [name, row, hold] of [['top-row-hold-250ms', 'top', 250], ['top-row-hold-60ms', 'top', 60], ['bottom-row-hold-250ms', 'bottom', 250], ['centre-hold-250ms', 'centre', 250]]) {
        const add = await addNode(300 + results.length, 'Script', 350); actions.push(add);
        const g = await page.evaluate((s) => { const r = document.querySelector(s).getBoundingClientRect(); return { x: r.x, y: r.y, w: r.width, h: r.height }; }, sel);
        const px = g.x + g.w / 2;
        const py = row === 'top' ? Math.ceil(g.y) : row === 'bottom' ? Math.ceil(g.y + g.h) - 1 : g.y + g.h / 2;
        const pre = await snap();
        const t0 = await page.evaluate(() => performance.now());
        await page.mouse.move(px, py, { steps: 3 });
        await sleep(150);
        const probe = (a) => { const t = document.elementFromPoint(a.x, a.y); return t && t.closest && t.closest('[data-history]') ? 'history:' + t.closest('[data-history]').getAttribute('data-history') : (t ? t.tagName.toLowerCase() : null); };
        const hitAtDown = await page.evaluate(probe, { x: px, y: py });
        await page.mouse.down();
        await sleep(hold);
        const heldBox = await page.evaluate((s) => { const r = document.querySelector(s).getBoundingClientRect(); return [r.x, r.y, r.width, r.height]; }, sel);
        const hitWhileHeld = await page.evaluate(probe, { x: px, y: py });
        await page.mouse.up();
        await sleep(450);
        const post = await snap();
        const evs = await page.evaluate((t) => window.__qa.since(t), t0);
        results.push({ name, hold, point: [px, py], restBox: [g.x, g.y, g.w, g.h], heldBox, hitAtDown, hitWhileHeld, events: evs, nodeDelta: post.nodes - pre.nodes, undoWasEnabled: pre.uAD === null, clickFiredOnButton: evs.some((e) => e.type === 'click' && !!e.hist), mouseupOnButton: evs.some((e) => e.type === 'mouseup' && !!e.hist) });
      }
      return results;
    });
    await phase('keyboard-space-hold', async () => {
      await page.evaluate(() => document.querySelector('[data-history=undo]').focus());
      const pre = await snap();
      await mark('kbd:space:down');
      await page.keyboard.down('Space');
      await sleep(250);
      const during = await page.evaluate(() => window.__qa.press('[data-history=undo]'));
      await page.keyboard.up('Space');
      await sleep(250);
      const post = await snap();
      return { pre: { nodes: pre.nodes, uAD: pre.uAD, focus: pre.focus }, during, post: { nodes: post.nodes, uAD: post.uAD, focus: post.focus }, nodeDelta: post.nodes - pre.nodes };
    });
    await phase('touch-hold-cdp', async () => {
      const coarse = await page.evaluate(() => matchMedia('(pointer: coarse)').matches);
      if (!coarse) return { skipped: 'primary pointer is fine in this configuration' };
      const cdp = await page.context().newCDPSession(page);
      try {
        const sel = '[data-history=redo]';
        const pre = await snap();
        const c = await center(sel);
        await mark('touch:start', { c: [c.x, c.y] });
        await cdp.send('Input.dispatchTouchEvent', { type: 'touchStart', touchPoints: [{ x: c.x, y: c.y }] });
        await sleep(250);
        const during = await page.evaluate((s) => window.__qa.press(s), sel);
        await cdp.send('Input.dispatchTouchEvent', { type: 'touchEnd', touchPoints: [] });
        await sleep(300);
        const post = await snap();
        return { sel, pre: { nodes: pre.nodes, rAD: pre.rAD }, during, post: { nodes: post.nodes, rAD: post.rAD }, nodeDelta: post.nodes - pre.nodes };
      } finally { await cdp.detach().catch(() => {}); }
    });
    await finalPhase();
  }

  async function caseControl() {
    await loadPhase(); await restPhase();
    const controls = [];
    const inject = (css, id) => page.evaluate((a) => { const s = document.createElement('style'); s.id = a.id; s.textContent = a.css; document.head.appendChild(s); }, { css, id });
    const remove = (id) => page.evaluate((i) => { const s = document.getElementById(i); if (s) s.remove(); return !document.getElementById(i); }, id);
    const variants = [
      ['margin-inline-end:1px on Undo', '[data-history=undo]{margin-inline-end:1px !important}'],
      ['position:relative;top:1px on Undo', '[data-history=undo]{position:relative !important;top:1px !important}'],
      ['translate:0 1px on Undo', '[data-history=undo]{translate:0 1px !important}'],
    ];
    for (let k = 0; k < variants.length; k++) {
      await phase('control-' + k, async () => {
        const before = await snap();
        await mark('control:inject:' + variants[k][0]);
        await inject(variants[k][1], 'qa-control-' + k);
        await sleep(300);
        const during = await snap();
        await mark('control:remove');
        const removed = await remove('qa-control-' + k);
        await sleep(300);
        const after = await snap();
        const rec = { name: variants[k][0], before: { ub: before.ub, rb: before.rb }, during: { ub: during.ub, rb: during.rb }, after: { ub: after.ub, rb: after.rb }, removedExactly: removed };
        controls.push(rec); return rec;
      });
    }
    await phase('control-one-frame', async () => {
      const before = await snap();
      await mark('control:one-frame:inject');
      await page.evaluate(() => new Promise((done) => {
        const s = document.createElement('style'); s.id = 'qa-control-1f'; s.textContent = '[data-history=undo]{position:relative !important;top:1px !important}';
        document.head.appendChild(s);
        requestAnimationFrame(() => requestAnimationFrame(() => { s.remove(); done(); }));
      }));
      await mark('control:one-frame:removed');
      await sleep(300);
      const after = await snap();
      const rec = { name: 'one-frame position:relative;top:1px on Undo', before: { ub: before.ub }, after: { ub: after.ub }, removedExactly: !(await page.evaluate(() => !!document.getElementById('qa-control-1f'))) };
      controls.push(rec); return rec;
    });
    out.controls = controls;
    await finalPhase();
  }

  async function caseH4(mode) {
    await loadPhase(); await restPhase();
    let offAt = null, onAt = null;
    const setFault = async (on) => {
      if (mode === 'offline') await page.context().setOffline(on);
      else if (mode === 'transportput') ctl.policy = on ? ((tag) => /^PUT .*\/draft$/.test(tag) ? { kind: 'abort' } : { kind: 'pass' }) : () => ({ kind: 'pass' });
      else if (mode === 'transportall') ctl.policy = on ? (() => ({ kind: 'abort' })) : () => ({ kind: 'pass' });
      else if (mode === 'http500') ctl.policy = on ? ((tag) => (/^PUT .*\/draft$/.test(tag) || /^POST .*\/validate$/.test(tag)) ? { kind: 'http500' } : { kind: 'pass' }) : () => ({ kind: 'pass' });
      if (on) onAt = Date.now(); else offAt = Date.now();
    };
    await phase('burstA', () => burst(0, 6, GAP));
    await phase('fault-on', async () => { await mark('fault:on:' + mode); await setFault(true); await sleep(1600); return { snap: await snap(), screenshot: await shot('fault-on') }; });
    await phase('burstB', () => burst(6, 12, GAP));
    await phase('fault-hold', async () => { await sleep(1500); return { snap: await snap(), screenshot: await shot('fault-held') }; });
    await phase('fault-off', async () => { await mark('fault:off:' + mode); await setFault(false); return { at: offAt }; });
    await phase('recovery', async () => {
      const t = Date.now(); let tBannerGone = null, tSaved = null, last = null;
      for (;;) {
        last = await snap();
        if (tBannerGone === null && !last.ban) tBannerGone = Date.now() - t;
        if (tSaved === null && last.save === 'All changes saved') tSaved = Date.now() - t;
        if (tBannerGone !== null && tSaved !== null && last.val !== 'Checking…') break;
        if (Date.now() - t > 45000) break;
        await sleep(100);
      }
      return { bannerGoneAfterRestoreMs: tBannerGone, savedAfterRestoreMs: tSaved, waitedMs: Date.now() - t, deadlineMs: 45000, last, screenshot: await shot('recovered') };
    });
    await phase('post-recovery-action', async () => {
      const r = await histClick(200, 'undo', { gap: 200 }); actions.push(r);
      return { nodeDelta: r.post.nodes - r.pre.nodes, preUAD: r.pre.uAD };
    });
    await phase('post-recovery-settle', async () => { const w = await waitFor((s) => s.save === 'All changes saved' && !s.ban, 20000, 150); return { ok: w.ok, waitedMs: w.waitedMs, snap: w.last }; });
    out.faultWindow = { mode, onAt, offAt };
    await finalPhase();
  }

  async function caseDialog() {
    await loadPhase(); await restPhase();
    await phase('add-one', async () => { const r = await addNode(0, 'Script', 400); actions.push(r); return { nodeDelta: r.post.nodes - r.pre.nodes }; });
    await phase('open-dialog', async () => {
      const rest = await snap();
      const nodeBox = await page.evaluate(() => { const el = document.querySelector('.react-flow__node[data-id="work"]'); if (!el) return null; const r = el.getBoundingClientRect(); return [r.x, r.y, r.width, r.height]; });
      if (!nodeBox) throw new Error('work node not rendered');
      const x = nodeBox[0] + nodeBox[2] / 2, y = nodeBox[1] + nodeBox[3] * 0.5;
      await mark('dialog:click-node', { x, y });
      await page.mouse.move(x, y, { steps: 3 }); await page.mouse.down(); await sleep(50); await page.mouse.up();
      const w = await waitFor((s) => s.dlg, 5000, 50);
      await sleep(400);
      const open = await snap();
      return { restUb: rest.ub, restRb: rest.rb, opened: w.ok, open, screenshot: await shot('dialog-open') };
    });
    await phase('dialog-state', async () => {
      const info = await page.evaluate(() => {
        const d = document.querySelector('dialog[open]');
        const u = document.querySelector('[data-history=undo]'), r = document.querySelector('[data-history=redo]');
        const hit = (el) => { if (!el) return null; const b = el.getBoundingClientRect(); const t = document.elementFromPoint(b.x + b.width / 2, b.y + b.height / 2); return t ? t.tagName.toLowerCase() + (t.closest('dialog') ? '(in dialog)' : '(outside dialog)') : null; };
        return { dialog: !!d, modal: d ? d.matches(':modal') : null, ariaModal: d ? d.getAttribute('aria-modal') : null, name: d ? (d.getAttribute('aria-label') || (d.querySelector('h1,h2') ? d.querySelector('h1,h2').textContent : null)) : null,
          undoHit: hit(u), redoHit: hit(r), undoInInertSubtree: !!(u && u.closest('[inert]')), undoBox: u ? u.getBoundingClientRect().toJSON() : null, redoBox: r ? r.getBoundingClientRect().toJSON() : null,
          active: document.activeElement ? document.activeElement.tagName.toLowerCase() + ':' + (document.activeElement.textContent || '').trim().slice(0, 40) : null };
      });
      return info;
    });
    await phase('tab-sweep', async () => {
      const seen = [];
      for (let k = 0; k < 24; k++) { await page.keyboard.press('Tab'); seen.push(await page.evaluate(() => { const a = document.activeElement; return { tag: a ? a.tagName.toLowerCase() : null, hist: a && a.getAttribute ? a.getAttribute('data-history') : null, inDialog: !!(a && a.closest && a.closest('dialog')), name: a ? ((a.getAttribute && (a.getAttribute('aria-label') || a.getAttribute('title'))) || (a.textContent || '').trim()).slice(0, 30) : null }; })); }
      return { reachedHistoryButton: seen.some((s) => s.hist), allInDialog: seen.every((s) => s.inDialog), seen };
    });
    await phase('click-undo-through-dialog', async () => {
      const pre = await snap();
      const c = await center('[data-history=undo]');
      await mark('dialog:click-undo-position', { c: [c.x, c.y] });
      await page.mouse.move(c.x, c.y, { steps: 2 }); await page.mouse.down(); await sleep(60); await page.mouse.up();
      await sleep(500);
      const post = await snap();
      return { nodeDelta: post.nodes - pre.nodes, dialogBefore: pre.dlg, dialogAfter: post.dlg, ubBefore: pre.ub, ubAfter: post.ub };
    });
    await phase('ctrl-z-in-dialog', async () => {
      let s0 = await snap();
      if (!s0.dlg) {
        const nb = await page.evaluate(() => { const el = document.querySelector('.react-flow__node[data-id="work"]'); if (!el) return null; const r = el.getBoundingClientRect(); return [r.x + r.width / 2, r.y + r.height / 2]; });
        if (nb) { await page.mouse.move(nb[0], nb[1], { steps: 2 }); await page.mouse.down(); await sleep(50); await page.mouse.up(); await waitFor((s) => s.dlg, 5000, 50); await sleep(300); }
        s0 = await snap();
      }
      const pre = s0;
      await mark('dialog:ctrl-z');
      await page.keyboard.press('Control+z');
      await sleep(500);
      const post = await snap();
      return { dialogBefore: pre.dlg, dialogAfter: post.dlg, nodeDelta: post.nodes - pre.nodes, focusBefore: pre.focus, focusAfter: post.focus, preUndoTitle: pre.uT, postUndoTitle: post.uT, ubBefore: pre.ub, ubAfter: post.ub, rbBefore: pre.rb, rbAfter: post.rb };
    });
    await phase('close-dialog', async () => {
      await page.keyboard.press('Escape'); await sleep(500);
      const s = await snap();
      const grid = await page.evaluate(() => window.__qa.hitGrid('[data-history=undo]'));
      return { dialogOpen: s.dlg, ub: s.ub, rb: s.rb, focus: s.focus, undoGrid: grid, screenshot: await shot('dialog-closed') };
    });
    await finalPhase();
  }

  // H2 boundary fixture: locate, at THIS configuration, the loop-name length at which the right-aligned
  // action group first wraps to its own row in the settled initial state, then run a short history
  // sequence on names at and just above that boundary and record every row flip.
  async function caseH2Tune() {
    const nameFor = (k) => 'n'.repeat(k);
    const geometry = () => page.evaluate(() => {
      const u = document.querySelector('[data-history=undo]'), hdr = u.closest('header'), grp = u.parentElement, h1 = hdr.querySelector('h1');
      const g = grp.getBoundingClientRect(), h = h1.getBoundingClientRect(), b = hdr.getBoundingClientRect();
      return { h1: [h.x, h.y, h.width, h.height], group: [g.x, g.y, g.width, g.height], hdr: [b.x, b.y, b.width, b.height], hdrClientWidth: hdr.clientWidth, h1Truncated: h1.scrollWidth > h1.clientWidth, undo: [u.getBoundingClientRect().x, u.getBoundingClientRect().y] };
    });
    const probe = async (k) => {
      loopName = nameFor(k);
      const r = await createAndOpen();
      const g = await geometry();
      return { k, wrapped: g.group[1] >= g.h1[1] + g.h1[3] - 1, settled: r.settled.ok, ...g };
    };
    const calib = await phase('calibrate', async () => {
      const probes = [];
      let lo = 10, hi = 119;
      const first = await probe(lo); probes.push(first);
      const last = await probe(hi); probes.push(last);
      if (first.wrapped || !last.wrapped) return { probes, boundary: null, note: 'no wrap boundary inside 10..119 characters at this configuration' };
      while (hi - lo > 1) { const mid = (lo + hi) >> 1; const p = await probe(mid); probes.push(p); if (p.wrapped) hi = mid; else lo = mid; }
      return { probes, boundary: hi, lastUnwrapped: lo };
    });
    const k0 = calib.result && calib.result.boundary;
    out.calibration = calib.result || null;
    if (!k0) return;
    const summarize = () => {
      const F = window.__qa.frames; const o = []; let last = null; let labels = null;
      for (const f of F) {
        if (f.x) labels = f.x;
        if (!f.u || !f.g || !f.h1 || !f.h) continue;
        const wrapped = f.g[1] >= f.h1[1] + f.h1[3] - 1;
        const sig = f.h[3] + '|' + wrapped;
        if (sig !== last) { o.push({ t: f.t, undoX: f.u[0], undoY: f.u[1], hdrH: f.h[3], frameY: f.fr ? f.fr[1] : null, wrapped, groupW: f.g[2], save: labels ? labels.save : null, val: labels ? labels.val : null }); last = sig; }
      }
      return o;
    };
    for (const k of [k0, Math.min(119, k0 + 2), Math.min(119, k0 + 4)]) {
      await phase('candidate-k' + k, async () => {
        loopName = nameFor(k);
        const r = await createAndOpen();
        const rest = await geometry();
        const steps = [];
        const settleAfter = async (name) => { await waitFor((s) => s.save === 'All changes saved', 8000, 50); await sleep(700); steps.push({ name, snap: await snap(), geometry: await geometry() }); };
        const a1 = await addNode(400 + k, 'Script', 120); actions.push(a1); await settleAfter('add-script');
        const a2 = await histClick(500 + k, 'undo', { gap: 120 }); actions.push(a2); await settleAfter('undo');
        const a3 = await histClick(600 + k, 'redo', { gap: 120 }); actions.push(a3); await settleAfter('redo');
        const transitions = await page.evaluate(summarize);
        const raw = await page.evaluate(() => JSON.stringify({ epoch0: window.__qa.epoch0, frames: window.__qa.frames, events: window.__qa.events }));
        await sinkPost(label + '.k' + k + '.frames.json', raw);
        return { k, nameLength: k, settled: r.settled.ok, rest, steps, transitions, rowFlips: Math.max(0, transitions.length - 1), actionsOk: [a1, a2, a3].map((a) => a.post.nodes - a.pre.nodes) };
      });
    }
  }

  // ---------------------------------------------------------------- run
  try {
    if (scenario === 'h2tune') await caseH2Tune();
    else if (scenario === 'h12') await caseH12();
    else if (scenario === 'h12held') await caseH12Held();
    else if (scenario === 'h3') await caseH3();
    else if (scenario === 'control') await caseControl();
    else if (scenario === 'dialog') await caseDialog();
    else if (/^h4(offline|transportput|transportall|http500)$/.test(scenario)) await caseH4(scenario.slice(2));
    else throw new Error('Unknown case ' + scenario);
  } catch (e) {
    out.failure = out.failure || { phase: 'driver', message: String(e && e.message ? e.message : e), stack: String(e && e.stack ? e.stack : e).slice(0, 1500) };
  }
  // ---------------------------------------------------------------- flush raw data (always)
  const flush = {};
  try {
    const raw = await page.evaluate(() => { const q = window.__qa; q.on = false; return JSON.stringify({ epoch0: q.epoch0, frames: q.frames, events: q.events }); });
    flush.frames = await sinkPost(label + '.frames.json', raw);
  } catch (e) { flush.framesError = String(e).slice(0, 300); }
  try {
    flush.actions = await sinkPost(label + '.actions.json', { label, scenario, config, nameMode, input: INPUT, gap: GAP, loopId, loopName, T0, meta: out.meta || null, phases: out.phases, actions, presses: out.presses || null, controls: out.controls || null,
      faultWindow: out.faultWindow || null, requests: reqLog, routes: routeLog, pageErrors: out.pageErrors, consoleErrors: out.consoleErrors });
  } catch (e) { flush.actionsError = String(e).slice(0, 300); }
  out.finishedAt = new Date().toISOString();
  out.summary = { phases: out.phases.map((p) => [p.name, p.ok]), failedPhases: out.phases.filter((p) => !p.ok).map((p) => p.name), actions: actions.length,
    effectMismatches: actions.filter((a) => a.deltaMatches === false).map((a) => a.i), requests: reqLog.length, routed: routeLog.length, flush, durationMs: Date.now() - T0 };
  return out;
}
)(page);
