      last = await snap();
      if (pred(last)) return { ok: true, waitedMs: Date.now() - t, last };
      if (Date.now() - t > timeoutMs) return { ok: false, waitedMs: Date.now() - t, last };
      await sleep(everyMs || 100);
    }
  }
  const settledValid = (s) => s.save === 'All changes saved' && s.val === 'Ready to publish' && !s.ban;
  const shot = async (name) => { try { await page.screenshot({ path: label + '-' + name + '.png', animations: 'disabled' }); return label + '-' + name + '.png'; } catch (e) { return 'screenshot failed: ' + String(e).slice(0, 120); } };

  // ---------------------------------------------------------------- fixture
  const node = (id, kind, lbl, x, y, cfg) => ({ id, kind, label: lbl, ui: { x, y }, config: cfg });
  const rand = crypto.randomUUID().slice(0, 6);
  loopName = nameMode === 'long'
    ? ('Stationarity long name ' + rand + ' ' + 'wide wrapping header content '.repeat(8)).slice(0, 120).trim()
    : 'Stat ' + rand;
  async function createAndOpen() {
    const graph = { schemaVersion: 4, name: loopName,
      nodes: [node('start', 'trigger', 'Manual entry', 0, 120, { type: 'manual' }),
        node('work', 'mutate', 'Note', 300, 120, { operations: [{ op: 'append-message', role: 'note', content: 'probe' }] }),
        node('done', 'exit', 'Finished', 620, 120, { outcome: 'success', returns: '"ok"' })],
      edges: [{ id: 'e1', from: { node: 'start', port: 'out' }, to: { node: 'work', port: 'in' } },
        { id: 'e2', from: { node: 'work', port: 'out' }, to: { node: 'done', port: 'in' } }] };
    loopId = (await api('POST', '/loops', 201, { definition: graph })).loop.id;
    await page.addInitScript(installSampler);
    // The app theme follows data-theme (default dark) and localStorage, not prefers-color-scheme.
    const theme = qp('theme', /light/.test(config) ? 'light' : 'dark');
    await page.evaluate((t) => { localStorage.setItem('graphgoblin-theme', t); }, theme);
    out.requestedTheme = theme;
    await page.goto(origin + '/app/loops/' + loopId + '/edit');
    await page.getByRole('heading', { name: loopName, exact: true }).waitFor({ timeout: 15000 });
    await page.getByText('The editor is available. Checking the server and this device before saving changes.', { exact: true }).waitFor({ state: 'hidden', timeout: 15000 });
    await page.locator('[data-history=undo]').waitFor({ timeout: 15000 });
    const settled = await waitFor(settledValid, 15000, 100);
    await sleep(400);
    const base = await page.evaluate(() => window.__qa.setBase());
    return { loopId, loopName, nameLength: loopName.length, settled: { ok: settled.ok, waitedMs: settled.waitedMs, last: settled.last }, base };
  }

  // ---------------------------------------------------------------- actions
  const BURST = ['add:Script', 'add:Mutate', 'add:Wait', 'undo', 'undo', 'undo', 'undo', 'redo', 'redo', 'redo', 'redo', 'undo'];
  const DELTA = [1, 1, 1, -1, -1, -1, 0, 1, 1, 1, 0, -1];
  const actions = [];
  async function addNode(i, kind, gap) {
    const rec = { i, spec: 'add:' + kind, input: 'locator.click', t0: Date.now(), pre: await snap() };
    await mark('act:' + i + ':add:' + kind);
    const addButton = page.getByRole('button', { name: 'Add ' + kind + ' node', exact: true }).first();
    if (INPUT === 'touch') await addButton.tap({ timeout: 9000 });
    else await addButton.click({ timeout: 9000 });
    rec.tAct = Date.now();
    await sleep(gap);
    rec.post = await snap(); rec.t1 = Date.now();
    return rec;
  }
  async function histClick(i, dir, opts) {
    const o = opts || {};
    const gap = o.gap === undefined ? GAP : o.gap, hold = o.hold === undefined ? 60 : o.hold, input = o.input || INPUT;
    const sel = '[data-history=' + dir + ']';
    const rec = { i, spec: dir, input, t0: Date.now(), pre: await snap() };
    const c1 = await center(sel);
    if (!c1) throw new Error('history button missing: ' + dir);
    rec.c1 = c1;
    if (input === 'touch') {
      const c2 = await center(sel); rec.c2 = c2;
      await mark('act:' + i + ':' + dir + ':tap', { c: [c2.x, c2.y] });
      await page.touchscreen.tap(c2.x, c2.y);
      rec.tAct = Date.now();
    } else {
      await page.mouse.move(c1.x, c1.y, { steps: 3 });
      const c2 = await center(sel); rec.c2 = c2;
      await mark('act:' + i + ':' + dir + ':down', { c: [c2.x, c2.y] });
      await page.mouse.move(c2.x, c2.y);
