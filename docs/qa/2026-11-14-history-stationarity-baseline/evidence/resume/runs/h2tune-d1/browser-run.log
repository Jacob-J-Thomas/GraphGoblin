  // ---------------------------------------------------------------- node-side plumbing
  let loopId = null, loopName = null;
  const reqLog = [], reqMap = new Map(), routeLog = [];
  let rseq = 0;
  page.on('pageerror', (e) => out.pageErrors.push(String(e && e.stack ? e.stack : e).slice(0, 600)));
  page.on('console', (m) => { if (m.type() === 'error') out.consoleErrors.push({ t: Date.now() - T0, text: m.text().slice(0, 300) }); });
  page.on('request', (r) => {
    const u = new URL(r.url());
    if (u.origin !== origin || u.pathname.startsWith('/app/')) return;
    const rec = { id: ++rseq, t: Date.now(), m: r.method(), p: loopId ? u.pathname.replace(loopId, ':id') : u.pathname };
    if (rec.m === 'PUT' && /\/draft$/.test(u.pathname)) {
      try { const b = JSON.parse(r.postData() || 'null'); rec.putNodes = b && b.definition && b.definition.nodes ? b.definition.nodes.length : null; rec.putName = b && b.definition ? String(b.definition.name).slice(0, 40) : null; } catch (e) { rec.putParseError = String(e); }
    }
    reqMap.set(r, rec); reqLog.push(rec);
  });
  page.on('response', (r) => { const rec = reqMap.get(r.request()); if (rec) { rec.status = r.status(); rec.tResp = Date.now(); } });
  page.on('requestfinished', (r) => { const rec = reqMap.get(r); if (rec) rec.tDone = Date.now(); });
  page.on('requestfailed', (r) => { const rec = reqMap.get(r); if (rec) { rec.failed = (r.failure() && r.failure().errorText) || 'failed'; rec.tFail = Date.now(); } });

  const ctl = { policy: () => ({ kind: 'pass' }) };
  await page.route((u) => u.origin === origin && !u.pathname.startsWith('/app/'), async (route) => {
    const req = route.request();
    const u = new URL(req.url());
    const tag = req.method() + ' ' + (loopId ? u.pathname.replace(loopId, ':id') : u.pathname);
    const rec = { t: Date.now(), tag, action: 'pass' };
    try {
      const pol = ctl.policy(tag, req.method());
      if (pol.kind === 'hold') { rec.action = 'hold'; rec.holdMs = pol.ms; await sleep(pol.ms); rec.releasedAt = Date.now(); await route.continue(); }
      else if (pol.kind === 'abort') { rec.action = 'abort'; await route.abort('connectionrefused'); }
      else if (pol.kind === 'http500') {
        rec.action = 'fulfill500';
        await route.fulfill({ status: 500, contentType: 'application/problem+json',
          body: jstr({ type: 'about:blank', title: 'Injected failure', status: 500, code: 'QA_INJECTED_HTTP_500', detail: 'Injected HTTP 500 for the #208 stationarity baseline' }) });
      } else await route.continue();
    } catch (e) { rec.error = String(e).slice(0, 200); }
    routeLog.push(rec);
  });

  async function sinkPost(name, data) {
    const body = typeof data === 'string' ? data : jstr(data);
    const r = await fetch(sink + '/sink/' + name, { method: 'POST', headers: { 'content-type': 'application/json' }, body });
    if (!r.ok) throw new Error('sink ' + name + ' answered ' + r.status);
    return body.length;
  }
  async function api(method, path, status, data) {
    const r = await page.request.fetch(origin + path, { method, timeout: 10000, ...(data === undefined ? {} : { data }) });
    const text = await r.text();
    if (r.status() !== status) throw new Error(method + ' ' + path + ' -> ' + r.status() + ' ' + text.slice(0, 300));
    return JSON.parse(text);
  }
  const mark = async (name, extra) => { try { await page.evaluate((a) => window.__qa && window.__qa.mark(a.name, a.extra), { name, extra: extra === undefined ? null : extra }); } catch (e) { /* page may be gone */ } };
  const snap = () => page.evaluate(() => window.__qa.snap());
  const center = (sel) => page.evaluate((s) => {
    const el = document.querySelector(s);
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return { x: r.x + r.width / 2, y: r.y + r.height / 2, box: [r.x, r.y, r.width, r.height], ad: el.getAttribute('aria-disabled'), title: el.getAttribute('title') };
  }, sel);
  async function phase(name, fn) {
    const rec = { name, t0: Date.now(), ok: true };
    out.phases.push(rec);
    await mark('phase:' + name + ':start');
    try { rec.result = await fn(); } catch (e) {
      rec.ok = false; rec.error = String(e && e.stack ? e.stack : e).slice(0, 1500);
      if (!out.failure) out.failure = { phase: name, message: String(e && e.message ? e.message : e), stack: rec.error };
    }
