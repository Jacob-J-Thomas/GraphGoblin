  async function press(sel, holdSamples, opts) {
    // Real mouse press held across transition + sampling windows; releases on the button.
    const o = opts || {};
    const rec = { sel, input: 'mouse', pre: await snap(), restPress: await page.evaluate((s) => window.__qa.press(s), sel) };
    rec.restGrid = await page.evaluate((s) => window.__qa.hitGrid(s), sel);
    const c = await center(sel);
    rec.c = c;
    await page.mouse.move(c.x, c.y, { steps: 3 });
    await sleep(150);
    rec.hoverPress = await page.evaluate((s) => window.__qa.press(s), sel);
    await mark('press:down:' + sel, { c: [c.x, c.y] });
    await page.mouse.down(); rec.tDown = Date.now();
    rec.held = [];
    for (const wait of holdSamples) {
      await sleep(wait);
      const s = await page.evaluate((a) => ({ p: window.__qa.press(a.sel), cu: document.elementFromPoint(a.x, a.y) ? document.elementFromPoint(a.x, a.y).tagName : null }), { sel, x: c.x, y: c.y });
      s.tRel = Date.now() - rec.tDown; rec.held.push(s);
    }
    rec.heldGrid = await page.evaluate((a) => window.__qa.hitGrid(a.sel, a.rect), { sel, rect: rec.restGrid ? rec.restGrid.rect : null });
    if (o.moveOffBeforeUp) { await page.mouse.move(c.x + 80, c.y + 80, { steps: 2 }); rec.movedOff = true; await sleep(100); }
    await page.mouse.up(); rec.tUp = Date.now();
    await sleep(40);
    rec.afterUp40 = await page.evaluate((s) => window.__qa.press(s), sel);
    await sleep(300);
    rec.afterUp340 = await page.evaluate((s) => window.__qa.press(s), sel);
    rec.post = await snap();
    return rec;
  }

  // ---------------------------------------------------------------- common phases
  async function loadPhase() {
    return phase('load', async () => {
      const r = await createAndOpen();
      out.meta = await page.evaluate(() => window.__qa.meta());
      out.appTheme = await page.evaluate(() => document.documentElement.dataset.theme || null);
      out.meta.appTheme = out.appTheme; out.meta.requestedTheme = out.requestedTheme;
      if (out.appTheme !== out.requestedTheme) throw new Error('App theme ' + out.appTheme + ' differs from requested ' + out.requestedTheme);
      return r;
    });
  }
  async function restPhase() {
    return phase('rest', async () => {
      await sleep(700);
      const attrs = await page.evaluate(() => window.__qa.attrs());
      const gridU = await page.evaluate(() => window.__qa.hitGrid('[data-history=undo]'));
      const gridR = await page.evaluate(() => window.__qa.hitGrid('[data-history=redo]'));
      const s = await snap();
      return { attrs, gridU, gridR, snap: s, screenshot: await shot('rest') };
    });
  }
  async function finalPhase() {
    return phase('final', async () => {
