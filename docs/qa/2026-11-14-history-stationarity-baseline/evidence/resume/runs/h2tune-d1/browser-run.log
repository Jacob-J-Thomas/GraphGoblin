      const rowHit = (y) => { const t = document.elementFromPoint(xm, y); return !!(t && t.closest && t.closest('[data-history]') === el); };
      const intRows = { insideTopRow: [r3(xm), top, rowHit(top)], insideBottomRow: [r3(xm), bot - 1, rowHit(bot - 1)], outsideAboveRow: [r3(xm), top - 1, rowHit(top - 1)], outsideBelowRow: [r3(xm), bot, rowHit(bot)] };
      return { rect: [r3(b.x), r3(b.y), r3(b.w), r3(b.h)], total: pts.length, hit, miss, intRows };
    };
    q.since = (t) => q.events.filter((e) => e.t >= t && ['mousedown', 'mouseup', 'click'].indexOf(e.type) >= 0).map((e) => ({ type: e.type, tg: e.tg, hist: e.hist, x: e.x, y: e.y, tr: e.tr || null }));
