      const el = document.querySelector(sel);
      if (!el) return null;
      const cs = getComputedStyle(el);
      return { translate: cs.translate, transform: cs.transform, active: el.matches(':active'), hover: el.matches(':hover'), focus: el.matches(':focus'),
        focusVisible: el.matches(':focus-visible'), box: bx(el), boxShadow: cs.boxShadow, opacity: cs.opacity, transition: cs.transitionProperty + ' ' + cs.transitionDuration };
    };
    q.attrs = () => {
      const o = {};
      for (const dir of ['undo', 'redo']) {
        const el = document.querySelector('[data-history=' + dir + ']');
        if (!el) { o[dir] = null; continue; }
        const hdr = el.closest('header');
        const foc = hdr ? [...hdr.querySelectorAll('a[href],button:not([disabled]),[tabindex]:not([tabindex="-1"])')] : [];
        const cs = getComputedStyle(el);
        o[dir] = { title: el.getAttribute('title'), dataHistory: el.getAttribute('data-history'), keyshortcuts: el.getAttribute('aria-keyshortcuts'),
          ariaDisabled: el.getAttribute('aria-disabled'), disabledProp: el.disabled, tabIndex: el.tabIndex, srOnly: txt(el.querySelector('.sr-only')),
          width: cs.width, height: cs.height, tag: el.tagName.toLowerCase(), type: el.getAttribute('type'), focusOrderInHeader: foc.indexOf(el),
          domIndexInGroup: [...el.parentElement.children].indexOf(el), cursor: cs.cursor };
      }
      const u = undoEl();
      o.groupClass = u ? u.parentElement.getAttribute('class') : null;
      o.headerClass = u && u.closest('header') ? u.closest('header').getAttribute('class') : null;
      return o;
    };
    q.meta = () => ({ w: innerWidth, h: innerHeight, dpr: devicePixelRatio, rootFont: getComputedStyle(document.documentElement).fontSize,
      bodyFont: getComputedStyle(document.body).fontSize, scheme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
      pointerCoarse: matchMedia('(pointer: coarse)').matches, pointerFine: matchMedia('(pointer: fine)').matches,
      anyCoarse: matchMedia('(any-pointer: coarse)').matches, hover: matchMedia('(hover: hover)').matches,
      reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches, maxTouchPoints: navigator.maxTouchPoints,
      ua: navigator.userAgent, platform: navigator.platform, online: navigator.onLine,
      vv: window.visualViewport ? [window.visualViewport.width, window.visualViewport.height, window.visualViewport.scale] : null,
