          const db = req.result;
          if (!db.objectStoreNames.contains('drafts')) { db.close(); resolve({ error: 'no drafts store', stores: [...db.objectStoreNames] }); return; }
          const tx = db.transaction('drafts', 'readonly'), st = tx.objectStore('drafts');
          const keys = st.getAllKeys(), vals = st.getAll();
          tx.oncomplete = () => { db.close(); resolve({ keys: keys.result, drafts: vals.result.map((d) => ({ loopId: d.loopId, nodes: d.definition && d.definition.nodes ? d.definition.nodes.length : null, synced: d.synced, savedAt: d.savedAt, hasBaseToken: !!d.baseToken })) }); };
