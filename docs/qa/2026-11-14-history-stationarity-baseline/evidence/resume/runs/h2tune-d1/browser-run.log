      let server = null;
      try { const r = await fetch(origin + '/loops/' + loopId); const j = await r.json(); server = { status: r.status, keys: Object.keys(j), draftNodes: j.draft && j.draft.definition ? j.draft.definition.nodes.length : null, currentVersion: j.current ? j.current.version : null, draftToken: j.draftToken }; } catch (e) { server = { error: String(e) }; }
