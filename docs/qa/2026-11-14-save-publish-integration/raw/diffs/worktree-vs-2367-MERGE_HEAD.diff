+  const response = await api.builtIn({
+    method: 'GET',
+    path: `/loops/${loopId}`,
+    search: new URLSearchParams(),
+    body: undefined,
+    headers: new Headers(),
+  });
+  type Version = { id: string; version: number; definition: { description?: string } };
+  return (await response.json()) as { current?: Version; draft?: Version };
+}
