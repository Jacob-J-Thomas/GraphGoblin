+  let state = { ...FLOW_READY };
+  return {
+    state: () => state,
+    subscribe: (listener: () => void) => {
+      listeners.add(listener);
+      return () => void listeners.delete(listener);
+    },
+    set: (next: Partial<typeof FLOW_READY>) => {
+      state = { ...state, ...next };
