+      expect(screen.getByRole('region', { name: '2 cards are stacked in one spot' })).toBeVisible();
+      expect(announced()).toBe('');
+
+      const first = await whenFirstAvailable(dismiss(), () => ({
+        blocker: clickBlocker(),
+        ...click(dismiss()),
+      }));
