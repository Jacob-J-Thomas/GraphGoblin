+    pane.dispatchEvent(mouse('mousedown', 600, 400, 0, 1));
+    pane.dispatchEvent(mouse('mousemove', 700, 400, 0, 1));
+    pane.dispatchEvent(mouse('mouseup', 700, 400, 0, 0));
