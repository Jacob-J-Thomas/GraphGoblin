+    pane.dispatchEvent(mouse('mousedown', 700, 400, 0, 1));
+    pane.dispatchEvent(mouse('mousemove', 760, 420, 0, 1));
+    await microtasks();
+    await queuedTask(() => undefined);
+    await queuedTask(() => undefined);
+    await microtasks();
