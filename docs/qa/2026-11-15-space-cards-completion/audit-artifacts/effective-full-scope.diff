+    pan();
+    act(() => store().undo());
+    expect(offer()).not.toBeNull();
+    expectGesture('panning');
+    release();
+    await untilAvailable();
+    expectGesture();
+  });
+
+  describe('the offer on its own, with the shared gate', () => {
+    const offerOn = (
+      viewportOf: Parameters<typeof SpaceCardsOffer>[0]['viewport'],
+      onSpace = vi.fn(),
+      onDismiss = vi.fn(),
+    ) => ({
