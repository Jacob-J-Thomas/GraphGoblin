new file mode 100644
index 00000000..d2c8a106
--- /dev/null
+++ b/apps/web/src/editor/viewport-gesture.ts
@@ -0,0 +1,90 @@
+/**
+ * Whether the selected connection's toolbar may act after a mouse pan of the canvas (#207).
+ *
+ * A mouse pan that moved ends in d3-zoom's window-capture `mouseup` handler. That handler first
+ * calls d3-drag's `yesdrag`, which adds a window-capture `click.drag` listener cancelling the next
+ * click anywhere on the page, and queues the listener's removal as a zero-delay task. A click on
+ * Remove connection in that interval was swallowed while the button looked enabled.
+ *
+ * The gate is `panning` from the canvas's first mouse move of a pan (xyflow's `onMove` with a
+ * `mousemove` source event; wheel, touch and programmatic moves add no blocker and never touch the
+ * gate), then `settling` once a mouse button is released, and `ready` again two tasks later. Its
+ * one passive window-capture `mouseup` listener is added when the canvas mounts, so it runs before
+ * the `mouseup` listener d3-zoom adds on each press (which stops the event). On a release it queues
+ * a zero-delay task that queues a second one. The first is queued before d3 queues its cleanup, so
+ * the second runs after that cleanup: only the second makes the gate ready, and only if no mouse
+ * move came since the release and the canvas is still mounted. This is a task-order barrier on the
+ * installed event order (pinned by `viewport-gesture.contract.test.tsx`), not a delay. A pan whose
+ * release never reaches the page keeps the gate unavailable until the next mouse release there,
+ * which also ends d3's gesture. The gate never prevents, stops or replays an event.
+ */
+export type ViewportGesture = 'ready' | 'panning' | 'settling';
+
+export interface ViewportGestureGate {
+  /** The gate now: only `ready` lets the toolbar act. */
+  state(this: void): ViewportGesture;
+  /** Called on every change of state; returns the unsubscribe. */
+  subscribe(this: void, listener: () => void): () => void;
+  /** xyflow's `onMove` source event: a `mousemove` (a mouse pan) makes the gate `panning`. */
+  move(this: void, event: Event | null | undefined): void;
+  /** Listen for mouse releases on `view` until the returned detach runs (the canvas unmounts). */
+  attach(this: void, view: Window): () => void;
+}
+
+/** A gate per canvas; it starts ready. */
+export function createViewportGestureGate(): ViewportGestureGate {
+  let state: ViewportGesture = 'ready';
+  // Advanced by every mouse move and by detaching: a release's barrier acts only on its own.
+  let generation = 0;
+  let pending: ReturnType<typeof setTimeout> | undefined;
+  const listeners = new Set<() => void>();
+
+  const set = (next: ViewportGesture) => {
+    if (next === state) return;
+    state = next;
+    for (const listener of [...listeners]) listener();
+  };
+  const cancel = () => {
+    if (pending === undefined) return;
+    clearTimeout(pending);
+    pending = undefined;
+  };
+  const release = () => {
+    if (state === 'ready') return;
+    // A later release restarts the barrier: it then also follows any cleanup this one queues.
+    cancel();
+    const released = generation;
+    set('settling');
+    // Use the global timer queue, the one d3-drag queues its cleanup on.
+    pending = setTimeout(() => {
+      pending = setTimeout(() => {
+        pending = undefined;
+        if (released === generation) set('ready');
+      }, 0);
+    }, 0);
+  };
+
+  return {
+    state: () => state,
+    subscribe(listener) {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+    move(event) {
+      if (event?.type !== 'mousemove') return;
+      generation += 1;
+      cancel();
+      set('panning');
+    },
+    attach(view) {
+      view.addEventListener('mouseup', release, { capture: true, passive: true });
+      return () => {
+        view.removeEventListener('mouseup', release, { capture: true });
+        generation += 1;
+        cancel();
+      };
+    },
+  };
+}
diff --git a/apps/web/src/editor/viewport-gesture.test.ts b/apps/web/src/editor/viewport-gesture.test.ts
new file mode 100644
index 00000000..44740598
--- /dev/null
+++ b/apps/web/src/editor/viewport-gesture.test.ts
@@ -0,0 +1,177 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { createViewportGestureGate, type ViewportGesture } from './viewport-gesture.js';
+
+const mousemove = () => new MouseEvent('mousemove');
+const release = (button = 0) => window.dispatchEvent(new MouseEvent('mouseup', { button }));
+
+/** Listeners and gates a test attached, released after it however it ended. */
+const cleanups: (() => void)[] = [];
+function attached(gate = createViewportGestureGate()) {
+  cleanups.push(gate.attach(window));
+  return gate;
+}
+
+/**
+ * A stand-in for the listener d3-zoom adds to the window on a press: it runs after the gate's (it is
+ * added later), queues its cleanup task as d3-drag's `yesdrag` does, and stops the event as d3's
+ * `noevent` does. It records how many timers were queued when it ran (`timers`, under fake timers)
+ * and the gate's state when its cleanup runs.
+ */
+function pressLikeD3(gate: { state(): ViewportGesture }, log: string[], timers?: () => number) {
+  const mouseupped = (event: MouseEvent) => {
+    if (timers) log.push(`d3 mouseup after ${timers()} queued`);
+    setTimeout(() => log.push(`cleanup:${gate.state()}`), 0);
+    event.stopImmediatePropagation();
+  };
+  window.addEventListener('mouseup', mouseupped, { capture: true });
+  cleanups.push(() => window.removeEventListener('mouseup', mouseupped, { capture: true }));
+}
+
+describe('viewport gesture gate (#207)', () => {
+  afterEach(() => {
+    for (const cleanup of cleanups.splice(0).reverse()) cleanup();
+    vi.useRealTimers();
+    vi.restoreAllMocks();
+  });
+
+  it('starts ready, and only a mouse move makes it unavailable, notifying once per change', () => {
+    const gate = createViewportGestureGate();
+    const changes: ViewportGesture[] = [];
+    const unsubscribe = gate.subscribe(() => changes.push(gate.state()));
+    expect(gate.state()).toBe('ready');
+    // Wheel, touch, a double click, a programmatic move: none adds d3's click blocker.
+    for (const event of [
+      new WheelEvent('wheel'),
+      new Event('touchmove'),
+      new MouseEvent('dblclick'),
+      new MouseEvent('mousedown'),
+      null,
+      undefined,
+    ])
+      gate.move(event);
+    expect(gate.state()).toBe('ready');
+    gate.move(mousemove());
+    gate.move(mousemove());
+    expect(gate.state()).toBe('panning');
+    expect(changes).toEqual(['panning']);
+    unsubscribe();
+    gate.move(mousemove());
+    expect(changes).toEqual(['panning']);
+  });
+
+  it('queues its first task before d3’s cleanup, and settles only in a later second task', () => {
+    vi.useFakeTimers();
+    const gate = attached();
+    const log: string[] = [];
+    gate.subscribe(() => log.push(gate.state()));
+    // A release while ready (a click on the pane) queues nothing.
+    release();
+    expect(vi.getTimerCount()).toBe(0);
+    // A press adds d3's listener after the gate's; the pan moves.
+    pressLikeD3(gate, log, () => vi.getTimerCount());
+    gate.move(mousemove());
+    release();
+    // The gate saw the release first, though d3's listener stops it, and had queued its first task.
+    expect(log).toEqual(['panning', 'settling', 'd3 mouseup after 1 queued']);
+    expect(vi.getTimerCount()).toBe(2);
+    // The first task and d3's cleanup (due at the same time) run: still settling, and the first
+    // task has only queued the second.
+    vi.advanceTimersToNextTimer();
+    expect(log).toEqual(['panning', 'settling', 'd3 mouseup after 1 queued', 'cleanup:settling']);
+    expect(gate.state()).toBe('settling');
+    expect(vi.getTimerCount()).toBe(1);
+    // The second task makes it ready.
+    vi.advanceTimersToNextTimer();
+    expect(log.at(-1)).toBe('ready');
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('a new mouse move invalidates a pending release, in either phase', () => {
+    vi.useFakeTimers();
+    const gate = attached();
+    // Before the first task.
+    gate.move(mousemove());
+    release();
+    gate.move(mousemove());
+    expect(gate.state()).toBe('panning');
+    expect(vi.getTimerCount()).toBe(0);
+    // Between the first task and the second.
+    release();
+    vi.advanceTimersToNextTimer();
+    expect(gate.state()).toBe('settling');
+    expect(vi.getTimerCount()).toBe(1);
+    gate.move(mousemove());
+    expect(vi.getTimerCount()).toBe(0);
+    vi.runAllTimers();
+    expect(gate.state()).toBe('panning');
+    // The newer pan's own release settles it.
+    release();
+    vi.runAllTimers();
+    expect(gate.state()).toBe('ready');
+  });
+
+  it('keeps one barrier for repeated releases, for any button, and ignores later wheel and programmatic ends', () => {
+    vi.useFakeTimers();
+    const gate = attached();
+    const changes: ViewportGesture[] = [];
+    gate.subscribe(() => changes.push(gate.state()));
+    gate.move(mousemove());
+    // A middle-button pan's release, then another button's release before the barrier ran.
+    release(1);
+    release(2);
+    expect(vi.getTimerCount()).toBe(1);
+    // Moves that are not a mouse pan's (a wheel, a fit) do not cancel the completion.
+    gate.move(new WheelEvent('wheel'));
+    gate.move(null);
+    vi.advanceTimersToNextTimer();
+    expect(gate.state()).toBe('settling');
+    expect(vi.getTimerCount()).toBe(1);
+    vi.advanceTimersToNextTimer();
+    expect(gate.state()).toBe('ready');
+    expect(vi.getTimerCount()).toBe(0);
+    expect(changes).toEqual(['panning', 'settling', 'ready']);
+  });
+
+  it('leaves no listener or task behind once detached', () => {
+    vi.useFakeTimers();
+    const add = vi.spyOn(window, 'addEventListener');
+    const remove = vi.spyOn(window, 'removeEventListener');
+    const gate = createViewportGestureGate();
+    const detach = gate.attach(window);
+    const [, listener, options] = add.mock.calls.find(([type]) => type === 'mouseup')!;
+    // Passive and in the capture phase: it never prevents or stops an event.
+    expect(options).toEqual({ capture: true, passive: true });
+    gate.move(mousemove());
+    release();
+    expect(vi.getTimerCount()).toBe(1);
+    detach();
+    expect(remove).toHaveBeenCalledWith('mouseup', listener, { capture: true });
+    expect(vi.getTimerCount()).toBe(0);
+    vi.runAllTimers();
+    // Nothing enables a gate whose canvas is gone, and later releases reach no listener.
+    expect(gate.state()).toBe('settling');
+    release();
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it('orders the barrier around a d3-like cleanup on the real timer queue', async () => {
+    const gate = attached();
+    const log: string[] = [];
+    pressLikeD3(gate, log);
+    gate.move(mousemove());
+    release();
+    // Queued after the release: after the gate's first task and d3's cleanup, before the second.
+    const queuedAfter = new Promise<ViewportGesture>((resolve) =>
+      setTimeout(() => resolve(gate.state()), 0),
+    );
+    const ready = new Promise<void>((resolve) =>
+      gate.subscribe(() => {
+        if (gate.state() === 'ready') resolve();
+      }),
+    );
+    expect(await queuedAfter).toBe('settling');
+    expect(log).toEqual(['cleanup:settling']);
+    await ready;
+    expect(gate.state()).toBe('ready');
+  });
+});
diff --git a/apps/web/src/editor/viewport-gesture.contract.test.tsx b/apps/web/src/editor/viewport-gesture.contract.test.tsx
new file mode 100644
index 00000000..7b3e81cf
--- /dev/null
+++ b/apps/web/src/editor/viewport-gesture.contract.test.tsx
@@ -0,0 +1,492 @@
+/**
+ * The pan gate's contract with the installed dependencies (#207): the real Canvas on
+ * @xyflow/react 12.12.0, @xyflow/system 0.0.83, d3-zoom 3.0.0 and d3-drag 3.0.0 in jsdom, on real
+ * timers. No dependency, window listener or timer is replaced. The fixture supplies only the layout
+ * jsdom lacks (card and pane sizes, and a ResizeObserver that reports them), so xyflow measures the
+ * cards and draws the connection; React schedules work as in a browser (no act environment).
+ *
+ * Readings are passive. Window listeners added by the test record whether each event was cancelled
+ * and whether it reached the window's bubble phase, and d3-selection's own bookkeeping on the
+ * window (`__on`) says which of d3's listeners are registered. Events are dispatched as a browser
+ * dispatches pointer input: mousedown, mousemove and mouseup with `view: window`, then the click.
+ */
+import type { LoopDefinitionInput } from '@graphgoblin/contracts';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import {
+  ReactFlowProvider,
+  useReactFlow,
+  useStoreApi,
+  type ReactFlowInstance,
+} from '@xyflow/react';
+import { useEffect } from 'react';
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { Canvas } from './Canvas.js';
+import { newLoopDefinition } from './model.js';
+import { NODE_CARD_SIZE } from './routing-geometry.js';
+import { useEditorStore } from './store.js';
+
+const actEnvironment = globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean | undefined };
+const VIEW = { width: 1200, height: 800 };
+
+/** jsdom has no layout: cards and the flow get their sizes; everything else stays 0 × 0. */
+function size(element: Element): { width: number; height: number } {
+  if (element.classList.contains('react-flow__node'))
+    return { width: NODE_CARD_SIZE.width, height: NODE_CARD_SIZE.height };
+  if (
+    element.classList.contains('react-flow') ||
+    element.classList.contains('react-flow__renderer')
+  )
+    return VIEW;
+  return { width: 0, height: 0 };
+}
+
+/** A ResizeObserver that reports each observed element once, as a browser does on observe. */
+class ReportingResizeObserver {
+  constructor(private readonly callback: ResizeObserverCallback) {}
+  observe(target: Element): void {
+    // xyflow reads an entry's `target` and, for the pane's extent, its `contentRect` size.
+    const { width, height } = size(target);
+    const contentRect = {
+      x: 0,
+      y: 0,
+      top: 0,
+      left: 0,
+      right: width,
+      bottom: height,
+      width,
+      height,
+    };
+    const entries = [{ target, contentRect }] as unknown as ResizeObserverEntry[];
+    queueMicrotask(() => this.callback(entries, this));
+  }
+  unobserve(): void {}
+  disconnect(): void {}
+}
+
+const saved = {
+  observer: globalThis.ResizeObserver,
+  width: Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'offsetWidth'),
+  height: Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'offsetHeight'),
+  act: actEnvironment.IS_REACT_ACT_ENVIRONMENT,
+};
+beforeAll(() => {
+  globalThis.ResizeObserver = ReportingResizeObserver;
+  Object.defineProperty(HTMLElement.prototype, 'offsetWidth', {
+    configurable: true,
+    get(this: HTMLElement) {
+      return size(this).width;
+    },
+  });
+  Object.defineProperty(HTMLElement.prototype, 'offsetHeight', {
+    configurable: true,
+    get(this: HTMLElement) {
+      return size(this).height;
+    },
+  });
+});
+afterAll(() => {
+  globalThis.ResizeObserver = saved.observer;
+  if (saved.width) Object.defineProperty(HTMLElement.prototype, 'offsetWidth', saved.width);
+  if (saved.height) Object.defineProperty(HTMLElement.prototype, 'offsetHeight', saved.height);
+});
+beforeEach(() => {
+  actEnvironment.IS_REACT_ACT_ENVIRONMENT = false;
+});
+afterEach(() => {
+  actEnvironment.IS_REACT_ACT_ENVIRONMENT = saved.act;
+});
+
+/**
+ * The page's window, as an event's `view` (a browser's `window`). In Vitest's jsdom environment the
+ * global `window` (also `document.defaultView` there) is the test global with jsdom's window
+ * functions bound to jsdom's own window, so a listener added through it (as the canvas adds the
+ * gate's) is on the same window as d3's. jsdom's event constructors accept only jsdom's own window,
+ * which Vitest exposes as `jsdom.window`, and d3 keeps its bookkeeping on `event.view`.
+ */
+const view = (globalThis as unknown as { jsdom: { window: Window } }).jsdom.window;
+
+/** d3-selection's record of the listeners d3 registered on the window, read and never changed. */
+function d3OnWindow(): string[] {
+  const on = (view as unknown as { __on?: { type: string; name: string }[] }).__on ?? [];
+  return on.map((listener) => `${listener.type}.${listener.name}`);
+}
+const clickBlocker = () => d3OnWindow().includes('click.drag');
+
+interface Reading {
+  type: string;
+  /** Cancelled before the test's capture listener (the first listener d3 can add after) ran. */
+  cancelledAtCapture: boolean;
+  /** d3's window listeners when the event reached the test's capture listener. */
+  d3: string[];
+  /** Whether the event went on to the window's bubble phase (d3's `noevent` stops it). */
+  bubbled: boolean;
+}
+
+/** Passive window listeners added after the canvas mounted and before any press. */
+function observeWindow() {
+  const readings = new Map<Event, Reading>();
+  const capture = (event: Event) =>
+    readings.set(event, {
+      type: event.type,
+      cancelledAtCapture: event.defaultPrevented,
+      d3: d3OnWindow(),
+      bubbled: false,
+    });
+  const bubble = (event: Event) => {
+    const reading = readings.get(event);
+    if (reading) reading.bubbled = true;
+  };
+  for (const type of ['mouseup', 'click']) {
+    window.addEventListener(type, capture, { capture: true, passive: true });
+    window.addEventListener(type, bubble, { passive: true });
+  }
+  return {
+    readings,
+    stop() {
+      for (const type of ['mouseup', 'click']) {
+        window.removeEventListener(type, capture, { capture: true });
+        window.removeEventListener(type, bubble);
+      }
+    },
+  };
+}
+
+const BUTTONS: Record<number, number> = { 0: 1, 1: 4 };
+function mouse(type: string, x: number, y: number, button = 0, buttons = 0) {
+  return new MouseEvent(type, {
+    bubbles: true,
+    cancelable: true,
+    composed: true,
+    view,
+    clientX: x,
+    clientY: y,
+    button,
+    buttons,
+    detail: type === 'click' ? 1 : 0,
+  });
+}
+
+/** Let the microtasks queued so far run (React commits a synchronous update in one), no task. */
+async function microtasks() {
+  for (let i = 0; i < 5; i += 1) await Promise.resolve();
+}
+
+/** A zero-delay task queued now, on the global queue d3 and the gate use, and its result. */
+function queuedTask<T>(read: () => T): Promise<T> {
+  return new Promise((resolve) => setTimeout(() => resolve(read()), 0));
+}
+
+let flow: ReactFlowInstance | undefined;
+const ends: (string | null)[] = [];
+
+/** The public `onMoveEnd` slot of xyflow's store, used here only to observe its end callbacks. */
+function Observe() {
+  flow = useReactFlow();
+  const store = useStoreApi();
+  useEffect(() => {
+    store.setState({ onMoveEnd: (event) => ends.push(event?.type ?? null) });
+  }, [store]);
+  return null;
+}
+
+function Live() {
+  const definition = useEditorStore((s) => s.definition)!;
+  return (
+    <ReactFlowProvider>
+      <Canvas definition={definition} issues={[]} />
+      <Observe />
+    </ReactFlowProvider>
+  );
+}
+
+const store = () => useEditorStore.getState();
+const remove = () => screen.getByRole('button', { name: 'Remove connection' });
+const stored = () => store().definition!.edges.map((edge) => edge.id);
+
+/** The canvas with start → done drawn and its connection `e1` selected, as a click selects it. */
+async function selectedConnection() {
+  const definition: LoopDefinitionInput = newLoopDefinition('Contract');
+  store().load('L1', definition);
+  const view = render(<Live />);
+  const wrapper = await waitFor(() => {
+    const found = view.container.querySelector<SVGGElement>('.react-flow__edge[data-id="e1"]');
+    expect(found).not.toBeNull();
+    return found!;
+  });
+  fireEvent.click(wrapper);
+  await waitFor(() => expect(remove()).toBeInTheDocument());
+  const pane = view.container.querySelector<HTMLElement>('.react-flow__pane')!;
+  return { view, pane, wrapper };
+}
+
+/**
+ * Resolves at the first moment Remove connection is shown available, running `act` right then: now,
+ * if it is shown available already (as before #207, when it never said otherwise).
+ */
+function whenFirstAvailable<T>(button: HTMLElement, act: () => T): Promise<T> {
+  if (!button.hasAttribute('aria-disabled')) return Promise.resolve(act());
+  return new Promise((resolve) => {
+    const observer = new MutationObserver(() => {
+      if (button.hasAttribute('aria-disabled')) return;
+      observer.disconnect();
+      resolve(act());
+    });
+    observer.observe(button, { attributes: true, attributeFilter: ['aria-disabled'] });
+  });
+}
+
+/**
+ * A click on `target` now: whether it stayed uncancelled, whether it reached its target (d3's
+ * window-capture `noevent` stops it before), and how the window's capture listener saw it. The
+ * window's bubble phase is no signal for a toolbar button: an accepted or refused click on it stops
+ * there, so the edge wrapper does not select the edge again.
+ */
+function click(target: Element, readings: Map<Event, Reading>, x = 0, y = 0) {
+  const event = mouse('click', x, y);
+  let reachedTarget = false;
+  const arrive = () => {
+    reachedTarget = true;
+  };
+  target.addEventListener('click', arrive, { passive: true });
+  const delivered = target.dispatchEvent(event);
+  target.removeEventListener('click', arrive);
+  return { delivered, reachedTarget, ...readings.get(event)! };
+}
+
+describe('the pan gate on the installed xyflow and d3 (#207)', () => {
+  beforeEach(() => {
+    ends.length = 0;
+    flow = undefined;
+  });
+
+  it('shows Remove unavailable while d3 cancels the next click, and delivers the first available click once', async () => {
+    const { pane } = await selectedConnection();
+    const button = remove();
+    // A new canvas, after its programmatic fit, is ready.
+    expect(button).not.toHaveAttribute('aria-disabled');
+    const windowEvents = observeWindow();
+    try {
+      // The pan: press on the pane, move past the click distance.
+      pane.dispatchEvent(mouse('mousedown', 600, 400, 0, 1));
+      // A listener added after the press runs after d3's, which stops the release.
+      const late: Event[] = [];
+      const lateListener = (event: Event) => late.push(event);
+      window.addEventListener('mouseup', lateListener, { capture: true });
+      await microtasks();
+      pane.dispatchEvent(mouse('mousemove', 710, 400, 0, 1));
+      await microtasks();
+      // What Remove says during the pan (asserted with the click below, so a failure shows both).
+      const duringPan = {
+        ariaDisabled: button.getAttribute('aria-disabled'),
+        gesture: button.getAttribute('data-gesture'),
+      };
+
+      // The release, and the click the browser dispatches with it.
+      const up = mouse('mouseup', 710, 400, 0, 0);
+      pane.dispatchEvent(up);
+      const panClick = click(pane, windowEvents.readings, 710, 400);
+      window.removeEventListener('mouseup', lateListener, { capture: true });
+      // The test's capture listener (added after the gate's at mount, before the press) saw the
+      // release with d3's per-press listener still registered and no blocker yet; the listener
+      // added after the press never ran.
+      expect(windowEvents.readings.get(up)).toEqual({
+        type: 'mouseup',
+        cancelledAtCapture: false,
+        d3: expect.arrayContaining(['mousemove.zoom', 'mouseup.zoom']) as string[],
+        bubbled: false,
+      });
+      expect(windowEvents.readings.get(up)!.d3).not.toContain('click.drag');
+      expect(late).toEqual([]);
+      // d3 cancelled the pan's own click; the connection stays selected.
+      expect(panClick).toMatchObject({
+        delivered: false,
+        reachedTarget: false,
+        cancelledAtCapture: false,
+        bubbled: false,
+      });
+      expect(panClick.d3).toContain('click.drag');
+
+      // A click on Remove while d3's blocker is registered: d3 cancels it before it reaches the
