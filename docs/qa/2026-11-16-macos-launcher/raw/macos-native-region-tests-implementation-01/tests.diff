+  expectFreshAbsent();
+  assert.deepEqual(identity(notExecutable, false), fileBefore);
+  assert.deepEqual(readFileSync(notExecutable), original);
+
+  // Unlike the non-executable input, this executable reaches the staged runtime probe.
+  install(
