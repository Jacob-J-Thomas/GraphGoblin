+  mkdirSync(dirname(join(badCheckout, goblinShell)), { recursive: true });
+  copyFileSync(join(repo, goblinShell), join(badCheckout, goblinShell));
+  writeFileSync(
+    join(badCheckout, 'apps/api/dist/instance-identity.js'),
