{
  "name": "graphgoblin",
  "private": true,
  "version": "0.1.0",
  "description": "Design, run, and observe agent loops. A PWA plus gateway backend for AI engineers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check:layers": "node tooling/scripts/check-layers.mjs",
    "check:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check:licenses": "node tooling/scripts/check-licenses.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:layers && pnpm check:deps && pnpm test:coverage && pnpm check:licenses",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
