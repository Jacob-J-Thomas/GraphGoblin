{
  "schemaVersion": 3,
  "settings": {
    "maxIterations": 4
  },
  "variables": {
    "count": {
      "type": "integer"
    },
    "done": {
      "type": "boolean"
    },
    "fail": {
      "type": "boolean"
    }
  },
  "name": "Issue 167 B: ordinary decision cycle",
  "nodes": [
    {
      "id": "start",
      "kind": "trigger",
      "label": "Start",
      "config": {
        "subtype": "manual"
      }
    },
    {
      "id": "work",
      "kind": "mutate",
      "label": "One deterministic pass",
      "config": {
        "operations": [
          {
            "op": "set",
            "path": "/vars/count",
            "value": {
              "kind": "expression",
              "jsonata": "($exists(vars.count) ? vars.count : 0) + 1"
            }
          },
          {
            "op": "set",
            "path": "/vars/done",
            "value": {
              "kind": "expression",
              "jsonata": "vars.count >= trigger.payload.k"
            }
          },
          {
            "op": "set",
            "path": "/vars/fail",
            "value": {
              "kind": "expression",
              "jsonata": "vars.count >= trigger.payload.failAt"
            }
          }
        ]
      }
    },
    {
      "id": "decide",
      "kind": "decision",
      "label": "Done, failure or another pass",
      "config": {
        "answer": {
          "type": "choice",
          "options": [
            {
              "id": "success",
              "label": "Success",
              "criteria": "Work is done"
            },
            {
              "id": "failure",
              "label": "Failure or limit",
              "criteria": "Explicit failure or continuation ceiling"
            },
            {
              "id": "continue",
              "label": "Continue",
              "criteria": "More work remains within ceiling"
            }
          ]
        },
        "evaluation": {
          "kind": "expression",
          "jsonata": "vars.done ? \"success\" : (vars.fail or vars.count >= 4) ? \"failure\" : \"continue\""
        }
      }
    },
    {
      "id": "success-exit",
      "kind": "exit",
      "label": "Return success",
      "config": {
        "return": {
          "mapping": "{\"count\": vars.count, \"done\": vars.done, \"fail\": vars.fail, \"iteration\": run.iteration, \"workStarts\": counters.nodeVisits.work}",
          "channels": [
            {
              "kind": "caller"
            },
            {
              "kind": "log"
            },
            {
              "kind": "event",
              "eventType": "research-result"
            },
            {
              "kind": "file",
              "path": "result.json",
              "format": "json"
            },
            {
              "kind": "webhook",
              "url": "https://example.test/research-result"
            }
          ]
        }
      }
    },
    {
      "id": "failure-exit",
      "kind": "exit",
      "label": "Return failure",
      "config": {
        "criteria": [
          {
            "when": "predicate",
            "answer": {
              "type": "noul"
            },
            "evaluation": {
              "kind": "expression",
              "jsonata": "true"
            },
            "match": {
              "type": "noul",
              "value": true
            },
            "outcome": "failure"
          }
        ],
        "return": {
          "mapping": "{\"count\": vars.count, \"done\": vars.done, \"fail\": vars.fail, \"iteration\": run.iteration, \"workStarts\": counters.nodeVisits.work}",
          "channels": [
            {
              "kind": "caller"
            },
            {
              "kind": "log"
            },
            {
              "kind": "event",
              "eventType": "research-result"
            },
            {
              "kind": "file",
              "path": "result.json",
              "format": "json"
            },
            {
              "kind": "webhook",
              "url": "https://example.test/research-result"
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "id": "start-work",
      "from": {
        "node": "start",
        "port": "out"
      },
      "to": {
        "node": "work"
      }
    },
    {
      "id": "work-decide",
      "from": {
        "node": "work",
        "port": "out"
      },
      "to": {
        "node": "decide"
      }
    },
    {
      "id": "decide-success",
      "from": {
        "node": "decide",
        "port": "success"
      },
      "to": {
        "node": "success-exit"
      }
    },
    {
      "id": "decide-failure",
      "from": {
        "node": "decide",
        "port": "failure"
      },
      "to": {
        "node": "failure-exit"
      }
    },
    {
      "id": "decide-work",
      "from": {
        "node": "decide",
        "port": "continue"
      },
      "to": {
        "node": "work"
      }
    }
  ]
}
