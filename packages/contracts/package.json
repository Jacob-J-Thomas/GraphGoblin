{
  "name": "@graphgoblin/contracts",
  "version": "0.1.0",
  "description": "Zod schemas and types shared by every GraphGoblin layer: loop definitions, node configs, context thread, runs, events, API DTOs.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@graphgoblin/tooling": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
