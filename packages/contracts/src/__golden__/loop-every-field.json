{
  "schemaVersion": 4,
  "name": "every-field",
  "description": "Every config field of every node kind, for parse checks.",
  "settings": {
    "workingDirectory": {
      "kind": "template",
      "template": "/work/{{ trigger.payload.repo }}"
    },
    "defaults": {
      "byHarness": {
        "codex": {
          "model": "gpt-6-luna",
          "effort": "medium"
        }
      }
    },
    "maxNodeVisits": 7,
    "runDeadlineSeconds": null,
    "subloopDepthLimit": 4
  },
  "variables": {
    "topic": {
      "type": "string"
    },
    "count": {
      "type": "number"
    }
  },
  "nodes": [
    {
      "id": "manual",
      "label": "Manual",
      "ui": {
        "x": 10,
        "y": 20
      },
      "kind": "trigger",
      "config": {
        "type": "manual",
        "inputSchema": {
          "type": "object"
        },
        "exposeTo": [
          "ui",
          "mcp"
        ]
      }
    },
    {
      "id": "cron",
      "label": "Cron",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "trigger",
      "config": {
        "type": "cron",
        "expression": "*/5 * * * *",
        "timezone": "Europe/Paris",
        "missedFirePolicy": "run-each",
        "enabled": false
      }
    },
    {
      "id": "hook",
      "label": "Hook",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "trigger",
      "config": {
        "type": "webhook",
        "authentication": {
          "type": "hmac-sha256",
          "message": "timestamp-body",
          "header": "x-sig",
          "secretRef": "hook-secret",
          "windowSeconds": 120
        },
        "body": {
          "type": "json"
        },
        "eventType": {
          "source": "constant",
          "value": "webhook"
        },
        "dedupeKey": "payload.id"
      }
    },
    {
      "id": "event",
      "label": "Event",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "trigger",
      "config": {
        "type": "event",
        "eventType": "build-done",
        "dedupeKey": "payload.id"
      }
    },
    {
      "id": "poller",
      "label": "Poller",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "trigger",
      "config": {
        "type": "poll",
        "intervalSeconds": 30,
        "probe": {
          "kind": "http",
          "method": "POST",
          "url": "https://example.test/{{ vars.topic }}",
          "headers": {
            "accept": "application/json"
          },
          "body": "{\"q\": 1}",
          "timeoutSeconds": 10
        },
        "fireWhen": "probe.status = 200",
        "dedupeKey": "probe.body.id",
        "enabled": false
      }
    },
    {
      "id": "github-hook",
      "label": "GitHub hook",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "trigger",
      "config": {
        "type": "webhook",
        "authentication": {
          "type": "hmac-sha256",
          "message": "body",
          "header": "x-hub-signature-256",
          "secretRef": "github-secret"
        },
        "body": {
          "type": "json"
        },
        "eventType": {
          "source": "constant",
          "value": "webhook"
        },
        "dedupeKey": "issue.number"
      }
    },
    {
      "id": "items-poller",
      "label": "Items poller",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "trigger",
      "config": {
        "type": "poll",
        "intervalSeconds": 30,
        "probe": {
          "kind": "script",
          "command": "gh",
          "args": [
            "api"
          ],
          "timeoutSeconds": 10
        },
        "fireWhen": "true",
        "items": {
          "select": "probe.json",
          "dedupeKey": "$string(item.number)",
          "maxRunsPerPoll": 5
        },
        "enabled": false
      }
    },
    {
      "id": "expression-decision",
      "label": "Expression",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "decision",
      "config": {
        "kind": "expression",
        "jsonata": "\"good\"",
        "maxPasses": 7,
        "maxRunTimeSeconds": 3600,
        "routes": [
          {
            "id": "good",
            "label": "Good"
          },
          {
            "id": "bad",
            "label": "Bad",
            "repeat": true
          }
        ]
      }
    },
    {
      "id": "classifier-decision",
      "label": "Classifier",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "decision",
      "config": {
        "kind": "classifier",
        "model": "jev",
        "question": "Choose",
        "minConfidence": 0.5,
        "truthThreshold": 0.7,
        "maxPasses": 7,
        "maxRunTimeSeconds": 3600,
        "answer": {
          "type": "noul",
          "true": {
            "id": "good",
            "label": "Good",
            "criteria": "Pass"
          },
          "false": {
            "id": "bad",
            "label": "Bad",
            "repeat": true,
            "criteria": "Fail"
          }
        },
        "context": {
          "messages": "all",
          "vars": [
            "topic"
          ],
          "includeLastOutput": true
        },
        "recordAlternatives": false
      }
    },
    {
      "id": "decide",
      "label": "Decide",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "decision",
      "config": {
        "kind": "llm",
        "instructions": "Is {{ vars.topic }} done?",
        "harness": "codex",
        "model": {
          "mode": "explicit",
          "value": "gpt-6-sol"
        },
        "effort": {
          "mode": "explicit",
          "value": "high"
        },
        "maxPasses": 7,
        "maxRunTimeSeconds": 3600,
        "routes": [
          {
            "id": "good",
            "label": "good"
          },
          {
            "id": "bad",
            "label": "bad",
            "repeat": true
          }
        ],
        "context": {
          "messages": 3,
          "vars": [
            "topic"
          ],
          "includeLastOutput": false
        }
      }
    },
    {
      "id": "infer",
      "label": "Infer",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "inference",
      "config": {
        "harness": "codex",
        "model": "gpt-6-sol",
        "effort": "xhigh",
        "session": {
          "policy": "resume-named",
          "key": "main"
        },
        "prompt": {
          "template": "Write about {{ vars.topic }}."
        },
        "input": [
          {
            "op": "truncate",
            "keep": {
              "last": 4
            }
          }
        ],
        "contextFiles": [
          {
            "path": "notes/context.md",
            "template": "# {{ vars.topic }}"
          }
        ],
        "harnessOptions": {
          "sandbox": "read-only",
          "approval": "on-request",
          "networkAccess": true,
          "webSearch": false,
          "configOverrides": {
            "model_verbosity": "low"
          }
        },
        "capabilities": {
          "mcpServers": [
            "github"
          ],
          "plugins": [
            "lint"
          ],
          "skills": [
            "review"
          ]
        },
        "output": {
          "captureTranscript": "none",
          "toMessages": "final-and-notes",
          "transforms": [
            {
              "op": "redact",
              "target": "all",
              "patterns": [
                "sk-[a-z0-9]+"
              ],
              "replacement": "[REDACTED]"
            }
          ],
          "schema": {
            "jsonSchema": {
              "type": "object"
            },
            "native": false,
            "repair": {
              "enabled": true,
              "maxAttempts": 2,
              "prompt": "Fix it.",
              "onFailure": "continue-raw"
            }
          }
        },
        "timeoutSeconds": 900
      }
    },
    {
      "id": "run-script",
      "label": "Script",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "script",
      "config": {
        "command": "node",
        "args": [
          "check.js",
          "{{ vars.topic }}"
        ],
        "cwd": "/srv/checks",
        "env": {
          "TOKEN": "secret:gh-token",
          "MODE": "strict"
        },
        "stdin": "last-output",
        "stdout": "patch",
        "exitCodeRoutes": {
          "3": "retry",
          "4": "skip"
        },
        "timeoutSeconds": 60
      }
    },
    {
      "id": "shape",
      "label": "Shape",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "mutate",
      "config": {
        "operations": [
          {
            "op": "set",
            "path": "/vars/a",
            "value": {
              "kind": "literal",
              "value": {
                "n": [
                  1,
                  null
                ]
              }
            }
          },
          {
            "op": "set",
            "path": "/vars/b",
            "value": {
              "kind": "template",
              "template": "{{ vars.a }}"
            }
          },
          {
            "op": "set",
            "path": "/vars/c",
            "value": {
              "kind": "expression",
              "jsonata": "vars.a.n"
            }
          },
          {
            "op": "delete",
            "path": "/vars/c"
          },
          {
            "op": "append-message",
            "role": "user",
            "content": "Hello",
            "tags": [
              "greeting"
            ]
          },
          {
            "op": "inject",
            "position": 1,
            "messages": [
              {
                "role": "system",
                "content": "Be brief.",
                "tags": [
                  "style"
                ]
              }
            ]
          },
          {
            "op": "truncate",
            "keep": {
              "first": 1,
              "last": 2,
              "maxEstimatedTokens": 4000
            },
            "where": "role = \"tool\""
          },
          {
            "op": "drop",
            "target": "artifacts",
            "where": "name = \"tmp\""
          },
          {
            "op": "replace",
            "target": "vars",
            "where": "true",
            "pattern": "foo",
            "flags": "gi",
            "replacement": "bar"
          },
          {
            "op": "redact",
            "target": "messages",
            "patterns": [
              "\\d{16}"
            ],
            "replacement": "[CARD]"
          },
          {
            "op": "coerce",
            "source": "/lastOutput/value",
            "jsonSchema": {
              "type": "object"
            },
            "repair": {
              "enabled": true,
              "maxAttempts": 2,
              "prompt": "Fix it.",
              "onFailure": "continue-raw"
            },
            "target": "/vars/coerced"
          }
        ]
      }
    },
    {
      "id": "sub",
      "label": "Sub",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "subloop",
      "config": {
        "loopRef": {
          "loopId": "YR3VKRN0N8NSTP5794CGCJ22KD",
          "version": 3
        },
        "input": {
          "mode": "project",
          "exclude": [
            "artifacts",
            "outputs"
          ],
          "vars": {
            "childTopic": "vars.topic"
          },
          "messages": {
            "where": "role = \"user\""
          },
          "artifacts": "all",
          "inject": [
            {
              "role": "note",
              "content": "From the parent.",
              "tags": [
                "parent"
              ]
            }
          ],
          "trigger": {
            "payload": "{ \"topic\": vars.topic }"
          }
        },
        "output": {
          "mode": "custom",
          "resultTo": {
            "lastOutput": false,
            "var": "childResult"
          },
          "vars": {
            "strategy": "explicit",
            "map": {
              "topic": "child.vars.topic"
            }
          },
          "messages": "last",
          "artifacts": {
            "where": "true"
          },
          "custom": {
            "patch": "[]"
          },
          "usage": "separate"
        },
        "depthLimitOverride": 2
      }
    },
    {
      "id": "ask",
      "label": "Ask",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "wait",
      "config": {
        "mode": "input",
        "prompt": "Approve {{ vars.topic }}?",
        "inputSchema": {
          "type": "boolean"
        },
        "exposeTo": [
          "ui"
        ],
        "timeoutSeconds": 600,
        "onTimeout": "fail-run"
      }
    },
    {
      "id": "pause",
      "label": "Pause",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "wait",
      "config": {
        "mode": "duration",
        "seconds": 30,
        "timeoutSeconds": 40,
        "onTimeout": "continue"
      }
    },
    {
      "id": "later",
      "label": "Later",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "wait",
      "config": {
        "mode": "until",
        "timestamp": "{{ vars.when }}",
        "timeoutSeconds": 86400,
        "onTimeout": "fail-run"
      }
    },
    {
      "id": "signal",
      "label": "Signal",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "wait",
      "config": {
        "mode": "signal",
        "name": "go",
        "filter": "payload.ok",
        "timeoutSeconds": 5,
        "onTimeout": "continue"
      }
    },
    {
      "id": "beat",
      "label": "Beat",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "heartbeat",
      "config": {
        "intervalSeconds": 15,
        "probe": {
          "kind": "script",
          "command": "check",
          "args": [
            "--fast"
          ],
          "timeoutSeconds": 20
        },
        "until": "probe.exitCode = 0",
        "maxBeats": 40,
        "deadline": "{{ vars.deadline }}",
        "onExhausted": "fail-run",
        "record": "full"
      }
    },
    {
      "id": "count",
      "label": "Count",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "heartbeat",
      "config": {
        "intervalSeconds": 5,
        "probe": {
          "kind": "signal-count",
          "name": "tick"
        },
        "maxBeats": 3,
        "onExhausted": "continue",
        "record": "summary"
      }
    },
    {
      "id": "done",
      "label": "Done",
      "ui": {
        "x": 0,
        "y": 0
      },
      "kind": "exit",
      "config": {
        "outcome": "success",
        "returns": "{ \"topic\": vars.topic }",
        "destinations": [
          {
            "kind": "caller"
          },
          {
            "kind": "webhook",
            "url": "https://example.test/done",
            "secretRef": "hook-secret"
          },
          {
            "kind": "file",
            "path": "out/result.md",
            "format": "markdown"
          },
          {
            "kind": "log"
          }
        ]
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "manual",
        "port": "out"
      },
      "to": {
        "node": "decide",
        "port": "in"
      },
      "ui": {
        "route": [
          240,
          360,
          420
        ]
      }
    }
  ]
}
