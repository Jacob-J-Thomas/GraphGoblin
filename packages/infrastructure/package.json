{
  "name": "@graphgoblin/infrastructure",
  "version": "0.1.0",
  "description": "Node infrastructure behind the engine's ports: SQLite persistence, filesystem, child processes, outbound HTTP, and persisted timers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "development": "./src/sqlite/index.ts",
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js"
    },
    "./fs": {
      "development": "./src/fs/index.ts",
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js"
    },
    "./process": {
      "development": "./src/process/index.ts",
      "types": "./dist/process/index.d.ts",
      "import": "./dist/process/index.js"
    },
    "./http": {
      "development": "./src/http/index.ts",
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./scheduler": {
      "development": "./src/scheduler/index.ts",
      "types": "./dist/scheduler/index.d.ts",
      "import": "./dist/scheduler/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@graphgoblin/contracts": "workspace:*",
    "@graphgoblin/domain": "workspace:*",
    "@graphgoblin/engine": "workspace:*",
    "@libsql/client": "^0.18.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@graphgoblin/tooling": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
