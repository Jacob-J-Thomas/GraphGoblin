          "timeoutSeconds": 300,
        },
        "id": "adversary",
        "kind": "inference",
        "label": "Challenge the assessment",
        "ui": {
          "x": 1080,
          "y": 0,
        },
      },
      {
        "config": {
          "jsonata": "outputs.adversary.value.assessment = 'sound' and outputs.qa.value.status = 'pass' ? 'passed' : (outputs.adversary.value.assessment = 'unsound' ? 'retry' : 'blocked')",
          "kind": "expression",
          "routes": [
            {
              "id": "passed",
              "label": "passed",
            },
            {
              "id": "retry",
              "label": "retry",
            },
            {
              "id": "blocked",
              "label": "blocked",
            },
          ],
        },
        "id": "assessment",
        "kind": "decision",
        "label": "Evidence assessment outcome",
        "ui": {
          "x": 1350,
          "y": 0,
        },
      },
      {
        "config": {
          "destinations": [
            {
              "kind": "caller",
            },
          ],
          "outcome": "success",
          "returns": "{"qa":outputs.qa.value,"challenge":outputs.adversary.value}",
        },
        "id": "done",
        "kind": "exit",
        "label": "Evidence assessment ready",
        "ui": {
          "x": 1620,
          "y": -160,
        },
      },
      {
        "config": {
          "destinations": [
            {
              "kind": "caller",
            },
          ],
          "outcome": "failure",
          "returns": "{"qa":outputs.qa.value,"challenge":outputs.adversary.value}",
        },
        "id": "blocked",
        "kind": "exit",
        "label": "Evidence missing or failed",
        "ui": {
          "x": 1620,
          "y": 160,
        },
      },
      {
        "config": {
          "destinations": [
            {
              "kind": "caller",
            },
          ],
          "outcome": "success",
          "returns": "{"qa":outputs.qa.value,"challenge":outputs.adversary.value}",
        },
        "id": "retry-complete",
        "kind": "exit",
        "label": "Reassess once within the limit",
        "ui": {
          "x": 810,
          "y": 300,
        },
      },
      {
        "config": {
          "destinations": [
            {
              "kind": "caller",
            },
          ],
          "outcome": "exhausted",
          "returns": "{"qa":outputs.qa.value,"challenge":outputs.adversary.value}",
        },
        "id": "retry-exhausted",
        "kind": "exit",
        "label": "Reassess once within the limit",
        "ui": {
          "x": 810,
          "y": 300,
        },
      },
      {
        "config": {
          "jsonata": ""repeat"",
          "kind": "expression",
          "maxPasses": 2,
          "routes": [
            {
              "id": "repeat",
              "label": "Repeat",
              "repeat": true,
            },
            {
              "id": "finish",
              "label": "Finish",
            },
          ],
        },
        "id": "retry",
        "kind": "decision",
        "label": "Reassess once within the limit",
        "ui": {
          "x": 810,
          "y": 300,
        },
      },
    ],
    "schemaVersion": 4,
    "settings": {
      "defaults": {
        "byHarness": {},
      },
      "maxNodeVisits": 2,
      "runDeadlineSeconds": null,
      "subloopDepthLimit": 8,
      "workingDirectory": {
        "kind": "temp",
      },
    },
    "variables": {},
  },
}
`;

