        "to": {
          "node": "reviewer",
          "port": "in",
        },
      },
      {
        "from": {
          "node": "retry",
          "port": "finish",
        },
        "id": "retry-finish",
        "to": {
          "node": "retry-complete",
          "port": "in",
        },
      },
      {
        "from": {
          "node": "retry",
          "port": "limit-reached",
        },
        "id": "retry-limit-reached",
        "to": {
          "node": "retry-exhausted",
          "port": "in",
        },
      },
    ],
    "name": "Review and fix starting point",
    "nodes": [
      {
        "config": {
          "exposeTo": [
            "ui",
            "api",
            "mcp",
          ],
          "type": "manual",
        },
        "id": "start",
        "kind": "trigger",
        "label": "Run input and context",
        "ui": {
          "x": 0,
          "y": 0,
        },
      },
      {
        "config": {
          "operations": [
            {
              "op": "set",
              "path": "/vars/instruction",
              "value": {
                "kind": "literal",
                "value": "Review the supplied change for correctness, regressions, maintainability, and focused verification. Fix actionable findings within the supplied scope.",
              },
            },
          ],
        },
        "id": "instructions",
        "kind": "mutate",
        "label": "Workflow instructions",
        "ui": {
          "x": 270,
          "y": 0,
        },
      },
      {
        "config": {
          "harness": "codex",
          "harnessOptions": {
            "approval": "never",
            "networkAccess": false,
            "sandbox": "read-only",
            "webSearch": false,
          },
          "input": [],
          "output": {
            "captureTranscript": "artifact",
            "schema": {
              "jsonSchema": {
                "additionalProperties": false,
                "properties": {
                  "findings": {
                    "items": {
                      "type": "string",
                    },
                    "maxItems": 32,
                    "type": "array",
                  },
                  "status": {
                    "enum": [
                      "approved",
                      "changes-needed",
                      "blocked",
                    ],
                    "type": "string",
                  },
                  "summary": {
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "status",
                  "summary",
                  "findings",
                ],
                "type": "object",
              },
              "native": true,
              "repair": {
                "enabled": true,
                "maxAttempts": 1,
                "onFailure": "fail-run",
              },
            },
            "toMessages": "final",
            "transforms": [],
          },
          "prompt": {
            "template": "Instructions:
{{ vars.instruction }}

Run input and any supplied repository/task context:
{{ invocation.trigger.payload | json }}

Use only the supplied context and accessible working directory. Missing repository URLs, issue/PR numbers, credentials, or ownership are unknown; do not invent them. This is a manual editable workflow. Do not commit, push, merge, create or close issues/PRs, change labels, or contact external services.

{% if outputs.fixer %}Latest fix and evidence:
{{ outputs.fixer.value | json }}
{% endif %}
Review supplied source/change context and accessible files. Return approved only when this review found no remaining actionable findings and its scope has enough evidence. Missing source or indispensable verification means blocked. Return changes-needed for actionable findings. This approval is a review opinion, not authenticated GitHub approval, CI proof, or permission to merge. Return the required JSON status, summary, and findings array.
",
          },
          "session": {
            "policy": "fresh",
          },
          "timeoutSeconds": 300,
        },
        "id": "reviewer",
        "kind": "inference",
        "label": "Review the change",
        "ui": {
          "x": 540,
          "y": 0,
        },
      },
      {
        "config": {
          "jsonata": "outputs.reviewer.value.status",
          "kind": "expression",
          "routes": [
            {
              "id": "approved",
              "label": "approved",
            },
            {
              "id": "changes-needed",
              "label": "changes-needed",
            },
            {
              "id": "blocked",
              "label": "blocked",
            },
          ],
        },
        "id": "verdict",
        "kind": "decision",
        "label": "Review outcome",
        "ui": {
          "x": 810,
          "y": 0,
        },
      },
      {
        "config": {
          "harness": "codex",
          "harnessOptions": {
            "approval": "never",
            "networkAccess": false,
            "sandbox": "workspace-write",
            "webSearch": false,
          },
          "input": [],
          "output": {
            "captureTranscript": "artifact",
            "toMessages": "final",
            "transforms": [],
          },
          "prompt": {
            "template": "Instructions:
{{ vars.instruction }}

Run input and any supplied repository/task context:
{{ invocation.trigger.payload | json }}

Use only the supplied context and accessible working directory. Missing repository URLs, issue/PR numbers, credentials, or ownership are unknown; do not invent them. This is a manual editable workflow. Do not commit, push, merge, create or close issues/PRs, change labels, or contact external services.

Review findings:
{{ outputs.reviewer.value | json }}

Address only these actionable findings. Edit accessible source in the configured working directory, or provide a concrete proposed patch when source is supplied as input. Explain what changed and which checks actually ran. Do not invent missing repository details or claim unperformed checks passed.
",
          },
          "session": {
            "policy": "fresh",
          },
          "timeoutSeconds": 900,
        },
        "id": "fixer",
        "kind": "inference",
        "label": "Fix or propose focused repairs",
        "ui": {
          "x": 810,
          "y": 300,
        },
      },
      {
        "config": {
          "destinations": [
            {
              "kind": "caller",
            },
          ],
          "outcome": "success",
          "returns": "outputs.reviewer.value",
        },
        "id": "retry-complete",
        "kind": "exit",
        "label": "Review again within the limit",
        "ui": {
          "x": 540,
          "y": 300,
        },
      },
      {
        "config": {
          "destinations": [
            {
              "kind": "caller",
            },
          ],
          "outcome": "exhausted",
          "returns": "outputs.reviewer.value",
        },
        "id": "retry-exhausted",
        "kind": "exit",
        "label": "Review again within the limit",
        "ui": {
          "x": 540,
          "y": 300,
        },
      },
      {
        "config": {
          "jsonata": ""repeat"",
          "kind": "expression",
          "maxPasses": 3,
          "routes": [
            {
              "id": "repeat",
              "label": "Repeat",
              "repeat": true,
            },
            {
              "id": "finish",
              "label": "Finish",
            },
          ],
        },
        "id": "retry",
        "kind": "decision",
        "label": "Review again within the limit",
        "ui": {
          "x": 540,
          "y": 300,
        },
      },
      {
        "config": {
          "destinations": [
            {
              "kind": "caller",
            },
          ],
          "outcome": "success",
          "returns": "outputs.reviewer.value",
        },
        "id": "done",
        "kind": "exit",
        "label": "Review opinion ready",
        "ui": {
          "x": 1080,
          "y": -160,
        },
      },
      {
        "config": {
          "destinations": [
            {
              "kind": "caller",
            },
          ],
          "outcome": "failure",
          "returns": "outputs.reviewer.value",
        },
        "id": "blocked",
        "kind": "exit",
        "label": "Review blocked",
        "ui": {
          "x": 1080,
          "y": 160,
        },
      },
    ],
    "schemaVersion": 4,
    "settings": {
      "defaults": {
        "byHarness": {},
      },
      "maxNodeVisits": 3,
      "runDeadlineSeconds": null,
      "subloopDepthLimit": 8,
      "workingDirectory": {
        "kind": "temp",
      },
    },
    "variables": {},
  },
}
`;

