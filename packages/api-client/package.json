{
  "name": "@graphgoblin/api-client",
  "version": "0.1.0",
  "description": "Typed client for the GraphGoblin REST API and its run event stream. Runs in browsers and Node.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate": "tsx --conditions=development scripts/generate.ts"
  },
  "dependencies": {
    "@graphgoblin/contracts": "workspace:*",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@graphgoblin/api": "workspace:*",
    "@graphgoblin/tooling": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
