{
  "name": "@graphgoblin/engine",
  "version": "0.1.0",
  "description": "The loop executor, run manager, and node handlers, written against ports. Boots fully with fake ports.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@graphgoblin/contracts": "workspace:*",
    "@graphgoblin/domain": "workspace:*"
  },
  "devDependencies": {
    "@graphgoblin/tooling": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
