{
  "name": "@graphgoblin/adapter-sqlite",
  "version": "0.1.0",
  "description": "SQLite persistence through Drizzle and libsql: runs, loops, events, sessions, timers, secrets, settings.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@graphgoblin/contracts": "workspace:*",
    "@graphgoblin/domain": "workspace:*",
    "@graphgoblin/engine": "workspace:*",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@graphgoblin/tooling": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
