      {
        "id": "verify",
        "label": "aidlc-trial-verify",
        "kind": "script",
        "config": {
          "command": "node",
          "args": [
            "-e",
            "let input='';process.stdin.setEncoding('utf8');process.stdin.on('data',c=>input+=c);process.stdin.on('end',()=>{try{const t=JSON.parse(input);const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');const root=fs.realpathSync(process.cwd());const files=[];function scan(dir){for(const e of fs.readdirSync(dir,{withFileTypes:true})){if(['.git','node_modules','.graphgoblin-trial'].includes(e.name))continue;const p=path.join(dir,e.name);if(e.isSymbolicLink())throw Error('Links are excluded from this trial');if(e.isDirectory())scan(p);else if(e.isFile())files.push(path.relative(root,p).split(path.sep).join('/'));}}scan(root);files.sort();if(!files.some(p=>/\\.test\\.(mjs|cjs|js)$/.test(p)))throw Error(\"A real Node test file is required\");const h=crypto.createHash('sha256');for(const p of files){h.update(p);h.update('\\0');h.update(fs.readFileSync(path.join(root,p)));h.update('\\0');}const candidateHash=h.digest('hex');const snap=t.outputs.snapshot.value,q=t.outputs.qa.value,review=t.outputs.review.value;const checklist=t.invocation.trigger.payload.checklist;if(JSON.stringify(JSON.parse(fs.readFileSync(path.join(root,'aidlc-trial-checklist.lock.json'),'utf8')))!==JSON.stringify(checklist))throw Error('Locked checklist mismatch');const checklistHash=crypto.createHash('sha256').update(JSON.stringify(checklist)).digest('hex');if(candidateHash!==snap.candidateHash||q.candidateHash!==candidateHash||review.candidateHash!==candidateHash)throw Error('Candidate changed or wrong candidate reviewed');if(q.checklistHash!==checklistHash||snap.checklistHash!==checklistHash)throw Error('Checklist mismatch');if(review.verdict!=='pass'||q.verdict!=='pass')throw Error('Review and QA must pass');if(q.results.length!==checklist.length||new Set(q.results.map(x=>x.id)).size!==checklist.length)throw Error('Checklist coverage mismatch');for(const item of checklist){const r=q.results.find(x=>x.id===item.id);if(!r||r.status!=='pass'||!r.evidence.length)throw Error('Missing passing criterion or evidence');for(const e of r.evidence){if(!e.path||path.isAbsolute(e.path))throw Error('Evidence path must be relative');const lexical=path.resolve(root,e.path);if(!lexical.startsWith(root+path.sep))throw Error('Evidence escaped workspace');const real=fs.realpathSync(lexical);if(!real.startsWith(root+path.sep))throw Error('Evidence escaped workspace');const bytes=fs.readFileSync(real);if(!bytes.length)throw Error('Empty evidence');const hash=crypto.createHash('sha256').update(bytes).digest('hex');if(hash!==e.sha256)throw Error('Evidence hash mismatch');}}console.log(JSON.stringify({ok:true,candidateHash,checklistHash,verifiedCriteria:checklist.map(x=>x.id)}));}catch(e){console.log(JSON.stringify({ok:false,reason:e.message}));process.exitCode=1;}});"
