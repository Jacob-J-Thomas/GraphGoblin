            "let input='';process.stdin.setEncoding('utf8');process.stdin.on('data',c=>input+=c);process.stdin.on('end',()=>{const t=JSON.parse(input);const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');const root=fs.realpathSync(process.cwd());const files=[];function scan(dir){for(const e of fs.readdirSync(dir,{withFileTypes:true})){if(['.git','node_modules','.graphgoblin-trial'].includes(e.name))continue;const p=path.join(dir,e.name);if(e.isSymbolicLink())throw Error('Links are excluded from this trial');if(e.isDirectory())scan(p);else if(e.isFile())files.push(path.relative(root,p).split(path.sep).join('/'));}}scan(root);files.sort();if(!files.some(p=>/\\.test\\.(mjs|cjs|js)$/.test(p)))throw Error(\"A real Node test file is required\");const h=crypto.createHash('sha256');for(const p of files){h.update(p);h.update('\\0');h.update(fs.readFileSync(path.join(root,p)));h.update('\\0');}const candidateHash=h.digest('hex');const checklist=t.invocation.trigger.payload.checklist;if(JSON.stringify(JSON.parse(fs.readFileSync(path.join(root,'aidlc-trial-checklist.lock.json'),'utf8')))!==JSON.stringify(checklist))throw Error('Locked checklist mismatch');if(!Array.isArray(checklist)||!checklist.length||new Set(checklist.map(x=>x.id)).size!==checklist.length)throw Error('Nonempty unique checklist required');if(JSON.stringify(t.outputs.plan.value.checklist)!==JSON.stringify(checklist))throw Error('Planner changed locked checklist');const checklistHash=crypto.createHash('sha256').update(JSON.stringify(checklist)).digest('hex');console.log(JSON.stringify({candidateHash,checklistHash,files}));});"
